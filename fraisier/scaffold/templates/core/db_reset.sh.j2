#!/usr/bin/env bash
# Generated by fraisier scaffold — do not edit manually
# Database reset script for {{ project_name }}
# WARNING: This script DROPS and recreates databases. Development use only.
#
# usage: db_reset.sh <environment> [--yes=<dbname>]...
# Each database is dropped only once its name is typed back, or given with
# --yes. dropdb reads the PG* variables of the shell that runs it, so one that
# could send it to another server or database refuses the reset, unless
# FRAISIER_RESET_ALLOW_PG_ENV=1 is exported.
set -euo pipefail

usage() {
    echo "Usage: $0 <environment> [--yes=<dbname>]..." >&2
    echo "Example: $0 development" >&2
    exit 1
}

{% include "core/_pg_target.sh.j2" %}

ENVIRONMENT=""
CONFIRMED=()
for arg in "$@"; do
    case "${arg}" in
        --yes=*) CONFIRMED+=("${arg#--yes=}") ;;
        -*) usage ;;
        *)
            if [ -n "${ENVIRONMENT}" ]; then
                usage
            fi
            ENVIRONMENT="${arg}"
            ;;
    esac
done

if [ -z "${ENVIRONMENT}" ]; then
    usage
fi

if [ "${ENVIRONMENT}" = "production" ]; then
    echo "ERROR: db_reset is not allowed in production." >&2
    exit 1
fi

DATABASES=(
{% for fraise in fraises %}
{% if not fraise.get('external_db', false) %}
    "{{ fraise.name }}"
{% endif %}
{% endfor %}
)

for db in "${DATABASES[@]}"; do
    pg_target dropdb "${db}" localhost postgres
done

FOUND=()
for var in PGHOST PGHOSTADDR PGPORT PGSERVICE PGDATABASE; do
    if [ -n "${!var+x}" ]; then
        FOUND+=("${var}")
    fi
done
if [ -n "${FOUND[*]:-}" ] && [ "${FRAISIER_RESET_ALLOW_PG_ENV:-}" != "1" ]; then
    echo "ERROR: ${FOUND[*]} is set in the environment, and dropdb would read it." >&2
    echo "Unset it, or export FRAISIER_RESET_ALLOW_PG_ENV=1 to reset anyway." >&2
    exit 1
fi

for given in "${CONFIRMED[@]+"${CONFIRMED[@]}"}"; do
    known=0
    for db in "${DATABASES[@]}"; do
        if [ "${given}" = "${db}" ]; then
            known=1
        fi
    done
    if [ "${known}" -eq 0 ]; then
        echo "ERROR: --yes=${given} names no database this script drops." >&2
        exit 1
    fi
done

echo "WARNING: This will DROP and recreate all databases for environment '${ENVIRONMENT}'."
for db in "${DATABASES[@]}"; do
    confirmed=0
    for given in "${CONFIRMED[@]+"${CONFIRMED[@]}"}"; do
        if [ "${given}" = "${db}" ]; then
            confirmed=1
        fi
    done
    if [ "${confirmed}" -eq 0 ]; then
        typed=""
        read -rp "Type the name of the database to drop (${db}): " typed || true
        if [ "${typed}" != "${db}" ]; then
            echo "Aborted: '${typed}' is not '${db}'. Nothing was dropped." >&2
            exit 1
        fi
    fi
done

for db in "${DATABASES[@]}"; do
    echo "==> Resetting database: ${db}"
    dropdb --if-exists -h localhost -U postgres "${db}"
    createdb -h localhost -U postgres -O "${db}" "${db}"
    echo "  Database ${db} recreated"
done

echo "All databases reset. Run db_deploy.sh to apply migrations."
