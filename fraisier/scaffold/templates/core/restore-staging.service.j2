[Unit]
Description=Restore {{ project_name }} staging database from production backup
After=network.target

[Service]
Type=oneshot
User={{ scaffold.deploy_user }}
Environment=PYTHONDONTWRITEBYTECODE=1
{% if allowed_services %}
Environment=FRAISIER_SYSTEMCTL_SOCKET=/run/fraisier/systemctl-{{ project_name }}.sock
{% endif %}
{% set fraisier_bin = '/home/' ~ scaffold.deploy_user ~ '/.local/bin/fraisier' %}
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% if env_config.get('database', {}).get('strategy') == 'restore_migrate' %}
{% if 'staging' in env_name or 'stage' in env_name %}
# --skip-if-locked: a deploy of this fraise holds the same lock, and a deploy
# is itself restoring staging from production — so a collision means the work
# is already being done. Exit 0 rather than failing the unit nightly (#310).
ExecStart={{ fraisier_bin }} --config {{ scaffold.config_path }} db restore {{ fraise.name }} {{ env_name }} --skip-if-locked
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}

# Security hardening
# ProtectHome intentionally omitted: fraisier is installed as a uv tool and
# runs from ~/.local, which ProtectHome=yes (and tmpfs) makes inaccessible.
# This unit set it while its ExecStart was that binary, so every firing would
# have been a 203/EXEC — unobserved because nothing ever enabled the timer
# (#341). Swept over every rendered unit by test_rendered_unit_sanity.py.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/fraisier /var/log/fraisier
{% set _seen_paths = [] %}
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% if env_config.get('database', {}).get('strategy') == 'restore_migrate' and env_config.get('app_path') and env_config.app_path not in _seen_paths %}
{% if _seen_paths.append(env_config.app_path) %}{% endif %}
ReadWritePaths={{ env_config.app_path }}
{% endif %}
{% endfor %}
{% endfor %}
