[Unit]
Description=Fraisier webhook server for {{ project_name }}
After=network.target
Wants=network-online.target

[Service]
Type=exec
User={{ scaffold.deploy_user }}
Group={{ scaffold.deploy_user }}
ExecStart=/home/{{ scaffold.deploy_user }}/.local/bin/fraisier-webhook
# systemctl reload drops the cached fraises.yaml so a config change takes
# effect without a full restart. The running server also auto-detects
# fraises.yaml mtime changes on the next deploy; SIGHUP forces it immediately.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# WatchdogSec intentionally omitted: uvicorn does not implement sd_notify
# watchdog pings, so WatchdogSec would kill the process every N seconds.

# Environment
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/home/{{ scaffold.deploy_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/fraisier/{{ project_name }}.webhook.env
{% if allowed_services %}
Environment=FRAISIER_SYSTEMCTL_SOCKET=/run/fraisier/systemctl-{{ project_name }}.sock
{% endif %}
{% for ish in install_helper_sockets %}
Environment={{ ish.env_var }}={{ ish.socket_path }}
{% endfor %}

# Resource limits
MemoryMax=512M
CPUAccounting=true

# Security hardening
# ProtectHome intentionally omitted: fraisier-webhook is installed as a uv tool
# and runs from ~/.local, which ProtectHome (any value) makes inaccessible.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Runtime directory (created by systemd at startup, owned by deploy user)
RuntimeDirectory=fraisier
RuntimeDirectoryMode=0750
# Preserve /run/fraisier/ across restarts so deploy socket files created by
# other units (fraisier-*.socket) survive webhook service restarts.
RuntimeDirectoryPreserve=restart

# Writable paths (from manifest, filtered by server via local_fraises)
# Collect all paths from local_fraises for server filtering
{% set local_app_paths = [] %}
{% set local_git_repos = [] %}
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% if env_config.get('app_path') %}
{% set _ = local_app_paths.append(env_config['app_path']) %}
{% endif %}
{% if env_config.get('git_repo') %}
{% set _ = local_git_repos.append(env_config['git_repo']) %}
{% endif %}
{% endfor %}
{% endfor %}
{% for mp in manifest.paths_for_unit("fraisier-webhook") %}
{% if mp.path|string in local_app_paths or mp.path|string in local_git_repos or mp.path|string in ("/opt/fraisier", "/var/lib/fraisier", "/run/fraisier") %}
ReadWritePaths={{ mp.path }}
{% endif %}
{% endfor %}
{# The pre-migration dump gate (#313) writes here from inside this sandbox.
   Without the entry every deploy with pending migrations fails closed on
   `Read-only file system`, and nothing before the deploy reveals it: the path
   is writable from a login shell, so preflight and doctor both pass (#317). #}
{% set _dump_dirs = [] %}
{% for fraise in local_fraises %}
{% for env_config in fraise.get('environments', {}).values() %}
{% set _pmd = (env_config.get('database') or {}).get('pre_migrate_dump') or {} %}
{% if _pmd.get('enabled') and _pmd.get('output_dir') and _pmd.get('output_dir') not in _dump_dirs %}
{% set _ = _dump_dirs.append(_pmd.get('output_dir')) %}
ReadWritePaths={{ _pmd.get('output_dir') }}
{% endif %}
{% endfor %}
{% endfor %}

[Install]
WantedBy=multi-user.target
