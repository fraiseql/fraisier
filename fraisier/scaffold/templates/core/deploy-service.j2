[Unit]
Description=Fraisier Deploy Service - {{ socket_stem }}
Requires={{ socket_unit_name }}
After={{ socket_unit_name }}
Documentation=https://fraisier.readthedocs.io/en/latest/socket-deployment.html

[Service]
Type=simple
User={{ scaffold.deploy_user }}
WorkingDirectory=/home/{{ scaffold.deploy_user }}
ExecStart=/home/{{ scaffold.deploy_user }}/.local/bin/fraisier deploy-daemon --project={{ fraise_name }}
StandardInput=socket
StandardOutput=journal
StandardError=journal
Environment=FRAISIER_CONFIG={{ scaffold.config_path }}
# Allow git fetch to succeed on first run without known_hosts pre-seeded.
Environment=GIT_SSH_COMMAND=ssh -o StrictHostKeyChecking=accept-new
{% if scaffold.deploy_environment_file %}
EnvironmentFile=-{{ scaffold.deploy_environment_file }}
{% endif %}

# Security hardening
# ProtectHome intentionally omitted: fraisier is installed as a uv tool and
# runs from ~/.local, which ProtectHome (any value) makes inaccessible.
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
# Deploy daemon must write to the bare git repo (fetch), the app worktree (checkout),
# the config file directory (fraises.yaml sync), and the lock/socket directory.
{% if env_config.get('git_repo') %}
ReadWritePaths={{ env_config['git_repo'] }}
{% endif %}
{% if env_config.get('app_path') %}
ReadWritePaths={{ env_config['app_path'] }}
{% endif %}
ReadWritePaths=/run/fraisier
ReadWritePaths={{ scaffold.config_dir }}

# Logging
SyslogIdentifier={{ socket_stem }}

[Install]
WantedBy=multi-user.target
