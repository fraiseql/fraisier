[Unit]
Description=Fraisier pgBackRest helper for {{ project_name }} ({{ helper.fraise }}-{{ helper.environment }})
Requires={{ helper_socket_unit }}
After={{ helper_socket_unit }}
Documentation=https://fraisier.readthedocs.io/en/latest/deployment-guide.html

[Service]
Type=simple
{# No User=: it runs as root, because stopping and starting a PostgreSQL cluster
   needs it. pgBackRest itself is run as the cluster's owner, by the helper.

   The stanza, repository, cluster and target are baked into ExecStart: the
   helper's authority is fixed when this unit is installed and is not decided per
   request. Only an operator installs it (#433): a deploy that renders a different
   one is stopped as pending until the operator runs scaffold-install. What also
   protects a cluster from a wrong or hostile `cluster:` is the helper's own
   refusal, from root-owned configuration, of any cluster that archives into its
   stanza.

   Comment markers here carry no minus sign. trim_blocks and lstrip_blocks
   already drop a standalone comment line; adding whitespace-control markers
   additionally eats the newline of the directive ABOVE, silently gluing two
   directives into one that systemd reads as neither. #}
ExecStart={{ root_python }} -I -m fraisier.pgbackrest_helper --deploy-user {{ scaffold.deploy_user }} --stanza {{ helper.spec.stanza }} --repo {{ helper.spec.repo }} --cluster {{ helper.spec.cluster }} --target {% if ' ' in helper.spec.target %}"{{ helper.spec.target }}"{% else %}{{ helper.spec.target }}{% endif %} --timeout {{ helper.spec.timeout_seconds }}

# Root-owned code only (#433): the root tool install's interpreter, isolated
# (-I) from PYTHONPATH, the working directory and any user site. No bytecode is
# written, so the root install never carries files nobody installed.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHON_DISABLE_REMOTE_DEBUG=1

# Security hardening, as far as a cluster restore allows.
# ProtectSystem=full rather than strict: the data directory is whatever
# pg_lsclusters says for the cluster, which this unit cannot know at render time,
# and a read-only mount over it would turn every restore into EROFS. /usr, /boot
# and /etc stay read-only. ProtectHome is omitted: a cluster's data directory
# may live under /home.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_INET/AF_INET6: pgBackRest may read its repository over TLS or SSH.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Logging
SyslogIdentifier=fraisier-pgbackrest-helper-{{ helper.fraise }}-{{ helper.environment }}
