[Unit]
Description=Fraisier pgBackRest helper for {{ project_name }} ({{ helper.fraise }}-{{ helper.environment }})
Requires={{ helper_socket_unit }}
After={{ helper_socket_unit }}
Documentation=https://fraisier.readthedocs.io/en/latest/deployment-guide.html

[Service]
Type=simple
{# No User=: it runs as root, because stopping and starting a PostgreSQL cluster
   needs it. pgBackRest itself is run as the cluster's owner, by the helper.

   The stanza, repository, cluster and target are baked into ExecStart and are
   NOT read from fraises.yaml when it runs. That file sits under a directory the
   deploy user owns; a root daemon that trusted it would let anyone who could
   write it retarget a cluster restore. This unit is installed by
   scaffold-install, which is the privileged, reviewed step — the install
   helper's baked allowlist (#279) is the same reasoning.

   Comment markers here carry no minus sign. trim_blocks and lstrip_blocks
   already drop a standalone comment line; adding whitespace-control markers
   additionally eats the newline of the directive ABOVE, silently gluing two
   directives into one that systemd reads as neither. #}
ExecStart=/home/{{ scaffold.deploy_user }}/.local/bin/fraisier-pgbackrest-helper --deploy-user {{ scaffold.deploy_user }} --stanza {{ helper.spec.stanza }} --repo {{ helper.spec.repo }} --cluster {{ helper.spec.cluster }} --target {% if ' ' in helper.spec.target %}"{{ helper.spec.target }}"{% else %}{{ helper.spec.target }}{% endif %} --timeout {{ helper.spec.timeout_seconds }}

# Prevent Python from creating root-owned __pycache__ dirs in the deploy user's
# tool installation when the helper runs as root.
Environment=PYTHONDONTWRITEBYTECODE=1

# Security hardening, as far as a cluster restore allows.
# ProtectSystem=full rather than strict: the data directory is whatever
# pg_lsclusters says for the cluster, which this unit cannot know at render time,
# and a read-only mount over it would turn every restore into EROFS. /usr, /boot
# and /etc stay read-only. ProtectHome is omitted because the binary lives in
# ~/.local, which it would hide.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_INET/AF_INET6: pgBackRest may read its repository over TLS or SSH.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Logging
SyslogIdentifier=fraisier-pgbackrest-helper-{{ helper.fraise }}-{{ helper.environment }}
