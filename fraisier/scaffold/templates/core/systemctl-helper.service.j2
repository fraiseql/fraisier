[Unit]
Description=Fraisier systemctl helper for {{ project_name }}
Requires=fraisier-{{ project_name }}-systemctl-helper.socket
After=fraisier-{{ project_name }}-systemctl-helper.socket
Documentation=https://fraisier.readthedocs.io/

[Service]
Type=simple
ExecStart={{ root_python }} -I -m fraisier.systemctl_helper --deploy-user {{ scaffold.deploy_user }}{% for svc in allowed_services %} {{ svc }}{% endfor %}

# Root-owned code only (#433): the root tool install's interpreter, isolated
# (-I) from PYTHONPATH, the working directory and any user site. No bytecode is
# written, so the root install never carries files nobody installed.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHON_DISABLE_REMOTE_DEBUG=1

# Security hardening — runs as root but restricted
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
