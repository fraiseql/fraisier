[Unit]
Description=Prune {{ prune.fraise }} pre-migration dumps for {{ project_name }} ({{ prune.environment }})
Documentation=https://fraisier.readthedocs.io/en/latest/deployment-guide.html

[Service]
Type=oneshot
User={{ scaffold.deploy_user }}
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHON_DISABLE_REMOTE_DEBUG=1
{# The unit carries a selector, not a policy (#420, as #339 decision 8).
   retention_hours, keep_last and the keep_minimum=1 floor stay in fraises.yaml
   and in the one helper the dump gate itself calls, so a policy change
   re-renders this unit only when it moves ReadWritePaths= or the schedule.

   The user is the deploy user: output_dir must be writable by it for the gate's
   own dump to land, so it is the one account that can delete from it.

   Comment markers here carry no minus sign. trim_blocks and lstrip_blocks
   already drop a standalone comment line; adding whitespace-control markers
   additionally eats the newline of the directive ABOVE, silently gluing two
   directives into one that systemd reads as neither. #}
ExecStart=/home/{{ scaffold.deploy_user }}/.local/bin/fraisier --config {{ scaffold.config_path }} backup prune --pre-migrate {{ prune.fraise }} --env {{ prune.environment }}

# Security hardening
# ProtectHome intentionally omitted: fraisier is installed as a uv tool and
# runs from ~/.local, which ProtectHome=yes (and tmpfs) makes inaccessible.
# Swept over every rendered unit by test_rendered_unit_sanity.py (#341).
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
{# Without the corpus, ProtectSystem=strict makes the prune a silent no-op: the
   unit runs, reports success and deletes nothing (#317's shape). The lock
   directory is what lets it take the deployment lock — the prune must not run
   while a gate is mid-dump. The leading "-" makes a missing /run/fraisier a
   loud "cannot acquire the deployment lock" from the command rather than a
   226/NAMESPACE the journal explains badly. #}
ReadWritePaths={{ prune.output_dir }} -/run/fraisier

# Logging
SyslogIdentifier=fraisier-pre-migrate-prune-{{ prune.fraise }}-{{ prune.environment }}
