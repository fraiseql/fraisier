#!/usr/bin/env bash
# Promote {{ pair.source }} → {{ pair.target }} for {{ project_name }}
# Generated by fraisier scaffold — do not edit manually
set -euo pipefail

SOURCE_BRANCH="{{ pair.source }}"
TARGET_BRANCH="{{ pair.target }}"
SYNC_BRANCH="sync/${TARGET_BRANCH}-from-${SOURCE_BRANCH}"

# Files always resolved from source branch (fraisier-managed or version-controlled)
AUTO_RESOLVED=(
    version.json
    pyproject.toml
    uv.lock
    .secrets.baseline
    fraises.yaml
    scripts/generated
)

ORIGINAL_BRANCH=$(git rev-parse --abbrev-ref HEAD)

_cleanup() {
    echo "  Returning to ${ORIGINAL_BRANCH}"
    git checkout "$ORIGINAL_BRANCH" 2>/dev/null || true
    git branch -D "$SYNC_BRANCH" 2>/dev/null || true
}

_is_auto_resolved() {
    local file="$1"
    for pattern in "${AUTO_RESOLVED[@]}"; do
        if [[ "$file" == "$pattern" || "$file" == "$pattern"/* ]]; then
            return 0
        fi
    done
    return 1
}

echo "==> Syncing ${SOURCE_BRANCH} → ${TARGET_BRANCH} for {{ project_name }}"

# Fetch latest refs
git fetch origin "${SOURCE_BRANCH}" "${TARGET_BRANCH}"

# Check if already in sync
SOURCE_SHA=$(git rev-parse "origin/${SOURCE_BRANCH}")
MERGE_BASE=$(git merge-base "origin/${SOURCE_BRANCH}" "origin/${TARGET_BRANCH}")

if [ "$MERGE_BASE" = "$SOURCE_SHA" ]; then
    echo "  Already up to date — nothing to sync"
    exit 0
fi

# Show version comparison
_get_version() {
    local branch="$1"
    git show "origin/${branch}:version.json" 2>/dev/null | jq -r '.version // empty' 2>/dev/null \
        || git show "origin/${branch}:pyproject.toml" 2>/dev/null | grep '^version' | head -1 | cut -d'"' -f2 \
        || echo "unknown"
}
SOURCE_VERSION=$(_get_version "$SOURCE_BRANCH")
TARGET_VERSION=$(_get_version "$TARGET_BRANCH")
echo "  Version: ${TARGET_VERSION} → ${SOURCE_VERSION}"

# Confirm before proceeding
read -r -p "  Proceed with sync? [y/N] " CONFIRM
if [[ "${CONFIRM,,}" != "y" ]]; then
    echo "  Aborted."
    exit 0
fi

# Create sync branch from source
echo "  Creating ${SYNC_BRANCH} from origin/${SOURCE_BRANCH}"
git checkout -b "$SYNC_BRANCH" "origin/${SOURCE_BRANCH}"
trap _cleanup EXIT

# Pre-merge target into sync branch to produce a clean PR (no DIRTY state)
echo "  Pre-merging origin/${TARGET_BRANCH} into ${SYNC_BRANCH}"
if ! git merge "origin/${TARGET_BRANCH}" --no-edit --no-commit 2>/dev/null; then
    # Resolve auto-resolved files by taking the source branch version
    while IFS= read -r conflicted_file; do
        if _is_auto_resolved "$conflicted_file"; then
            git checkout "origin/${SOURCE_BRANCH}" -- "$conflicted_file" 2>/dev/null || true
            git add "$conflicted_file" 2>/dev/null || true
        fi
    done < <(git diff --name-only --diff-filter=U)

    # Fail loudly if any non-owned conflicts remain
    REMAINING=$(git diff --name-only --diff-filter=U)
    if [ -n "$REMAINING" ]; then
        echo "  ✗ Unresolved conflicts in non-fraisier-owned files:" >&2
        echo "$REMAINING" | sed 's/^/    /' >&2
        echo "  Resolve these manually before running this script." >&2
        exit 1
    fi

    git commit --no-edit -m \
        "Pre-merge ${TARGET_BRANCH} into sync branch (auto-resolved fraisier files)"
fi

# Push sync branch
echo "  Pushing ${SYNC_BRANCH}"
git push origin "$SYNC_BRANCH"

# Create PR targeting the target environment branch
echo "  Creating PR: ${SYNC_BRANCH} → ${TARGET_BRANCH}"
PR_URL=$(gh pr create \
    --title "Promote ${SOURCE_BRANCH} → ${TARGET_BRANCH}" \
    --body "Automated promotion of \`${SOURCE_BRANCH}\` → \`${TARGET_BRANCH}\` for {{ project_name }}." \
    --base "$TARGET_BRANCH" \
    --head "$SYNC_BRANCH" \
    --no-maintainer-edit)

# Enable auto-merge so the PR merges automatically when CI passes
gh pr merge --auto --squash "$PR_URL"

trap - EXIT
git checkout "$ORIGINAL_BRANCH"
echo "==> Done. PR created and auto-merge enabled: ${PR_URL}"
