[Unit]
Description=Fraisier scaffold-install helper for {{ project_name }}
Requires=fraisier-{{ project_name }}-scaffold-install-helper.socket
After=fraisier-{{ project_name }}-scaffold-install-helper.socket

[Service]
Type=simple
# No User= directive — runs as root so install.sh can write to /etc/.
# ExecStart references the deploy user's venv — same pattern as systemctl-helper.
# Root can execute binaries in any user's home; no privilege issue.
ExecStart=/home/{{ scaffold.deploy_user }}/.local/bin/fraisier-scaffold-install-helper {{ scaffold_install_script }}

# Prevent Python from creating root-owned __pycache__ dirs in the deploy user's
# tool installation when the helper runs as root.
Environment=PYTHONDONTWRITEBYTECODE=1

# Security hardening.
# NoNewPrivileges is safe because we are already root; we do not need setuid.
# ProtectSystem cannot be 'strict' because this service writes to /etc/.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# install.sh writes to these paths; all others are read-only.
ReadWritePaths=/etc/systemd/system /etc/nginx /etc/sudoers.d /run/fraisier

[Install]
WantedBy=multi-user.target
