[Unit]
Description=Fraisier scaffold-install helper for {{ project_name }}
Requires=fraisier-{{ project_name }}-scaffold-install-helper.socket
After=fraisier-{{ project_name }}-scaffold-install-helper.socket

[Service]
Type=simple
# No User= directive: it runs as root to write units into /etc/systemd/system.
# It runs no script. It reads the deploy's render as untrusted input and writes
# only the units the root policy (/etc/fraisier/{{ project_name }}/root-policy.json)
# grants, with content that passes its allowlist (#433).
ExecStart={{ root_python }} -I -m fraisier.scaffold_install_helper --deploy-user {{ scaffold.deploy_user }} --project {{ project_name }}

# Root-owned code only (#433): the root tool install's interpreter, isolated
# (-I) from PYTHONPATH, the working directory and any user site. No bytecode is
# written, so the root install never carries files nobody installed.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHON_DISABLE_REMOTE_DEBUG=1

# Security hardening.
# NoNewPrivileges is safe because we are already root; we do not need setuid.
# Everything but the unit directory is read-only: sudoers, nginx, users and
# directories are an operator's, installed by `sudo fraisier scaffold-install`.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/etc/systemd/system

[Install]
WantedBy=multi-user.target
