[Unit]
Description=Fraisier unit-installer for {{ project_name }} ({{ env_name }})
Requires=fraisier-{{ project_name }}-{{ env_name }}-unit-installer.socket
After=fraisier-{{ project_name }}-{{ env_name }}-unit-installer.socket
Documentation=https://fraisier.readthedocs.io/

[Service]
Type=simple
# Runs as root: must write to /etc/systemd/system/ and invoke systemctl.
# SO_PEERCRED restricts connections to the deploy user only.
ExecStart={{ root_python }} -I -m fraisier.unit_installer_helper --deploy-user {{ scaffold.deploy_user }} --project {{ project_name }} --env {{ env_name }}{% for pair in unit_installer_allow_pairs %} --allow {{ pair }}{% endfor %}

# Root-owned code only (#433): the root tool install's interpreter, isolated
# (-I) from PYTHONPATH, the working directory and any user site. No bytecode is
# written, so the root install never carries files nobody installed.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHON_DISABLE_REMOTE_DEBUG=1

# Security hardening — runs as root but restricted.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
# Writes to systemd unit dir + per-env lock dir; reads everywhere else.
ReadWritePaths=/etc/systemd/system /var/lib/fraisier /run/fraisier

[Install]
WantedBy=multi-user.target
