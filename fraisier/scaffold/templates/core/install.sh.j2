#!/usr/bin/env bash
# Generated by fraisier scaffold — do not edit manually
# Server setup script for {{ project_name }}
# Idempotent: safe to re-run
set -euo pipefail

# Parse options
DRY_RUN=false
VALIDATE_ONLY=false
VERBOSE=false
STANDALONE=false
SCAFFOLD_DIR=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --validate-only)
      VALIDATE_ONLY=true
      shift
      ;;
    --verbose|-v)
      VERBOSE=true
      shift
      ;;
    --standalone)
      STANDALONE=true
      shift
      ;;
    --scaffold-dir)
      SCAFFOLD_DIR="$2"
      STANDALONE=true
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  --dry-run                 Show what would be installed without executing"
      echo "  --validate-only           Check prerequisites only (no installation)"
      echo "  --verbose, -v             Enable verbose output"
      echo "  --standalone              Run without requiring PROJECT_DIR to exist"
      echo "  --scaffold-dir <path>     Path to scaffold files (implies --standalone)"
      echo "  --help, -h                Show this help message"
      exit 0
      ;;
    *)
      echo "Error: Unknown option '$1'" >&2
      echo "Use --help for usage information" >&2
      exit 1
      ;;
  esac
done

DEPLOY_USER="{{ scaffold.deploy_user }}"
PROJECT_DIR="/opt/{{ project_name }}"

# Determine the directory containing scaffold files.
# Default: the directory that contains this script (works when install.sh is
# deployed alongside the other generated files).  Override with --scaffold-dir.
if [[ -z "$SCAFFOLD_DIR" ]]; then
  SCAFFOLD_DIR="$(dirname "$(realpath "$0")")"
fi

# Server detection (baked at scaffold time by fraisier)
{% if machine_env_map %}
# Multi-server mode: filter based on runtime hostname
declare -A _FRAISIER_MACHINE_ENVS
{% for machine, envs in machine_env_map.items() %}
_FRAISIER_MACHINE_ENVS["{{ machine }}"]="{{ envs | join(' ') }}"
{% endfor %}

_FRAISIER_CURRENT_HOST=$(hostname -s)
_FRAISIER_CURRENT_ENVS="${_FRAISIER_MACHINE_ENVS["$_FRAISIER_CURRENT_HOST"]:-}"
if [[ -z "$_FRAISIER_CURRENT_ENVS" ]]; then
    echo "Error: This machine ('$_FRAISIER_CURRENT_HOST') is not registered in fraises.yaml." >&2
    echo "  Known machines: {{ machine_env_map.keys() | list | join(', ') }}" >&2
    echo "  Add this machine under 'servers:' and re-run 'fraisier scaffold'." >&2
    exit 1
fi

_env_active() { [[ " $_FRAISIER_CURRENT_ENVS " == *" $1 "* ]]; }

# Webhook unit selection (#325). The unit is addressed by host: the scaffold
# tree carries one fraisier-{project}-webhook-{slug}.service per logical
# server, and this machine installs its own. There is deliberately no fallback
# to a host-agnostic name — a leftover from a differently-filtered render is
# exactly what shipped another host's ReadWritePaths= into production.
declare -A _FRAISIER_MACHINE_WEBHOOK
{% for machine, unit in machine_webhook_map.items() %}
_FRAISIER_MACHINE_WEBHOOK["{{ machine }}"]="{{ unit }}"
{% endfor %}
_FRAISIER_WEBHOOK_UNIT="${_FRAISIER_MACHINE_WEBHOOK["$_FRAISIER_CURRENT_HOST"]:-}"
if [[ -z "$_FRAISIER_WEBHOOK_UNIT" ]]; then
    echo "Error: no webhook unit was rendered for this machine ('$_FRAISIER_CURRENT_HOST')." >&2
    echo "  Machines with a unit: {{ machine_webhook_map.keys() | list | join(', ') }}" >&2
    echo "  Add this machine under 'servers:' and re-run 'fraisier scaffold'." >&2
    exit 1
fi
{% else %}
# servers: section is required
echo "Error: 'servers:' section is required in fraises.yaml." >&2
echo "  Add logical servers and machine hostnames, then re-run 'fraisier scaffold'." >&2
exit 1
{% endif %}

# Helper function to run commands conditionally
_run() {
  if [[ "$VALIDATE_ONLY" == "true" ]]; then
    if [[ "$VERBOSE" == "true" ]]; then
      echo "  [validate] $*"
    fi
    return 0
  elif [[ "$DRY_RUN" == "true" ]]; then
    echo "  [would run] $*"
    return 0
  else
    if [[ "$VERBOSE" == "true" ]]; then
      "$@"
    else
      "$@" 2>/dev/null || true
    fi
  fi
}

# Like _run, but failures are FATAL — no `|| true`, no stderr suppression — so
# a broken step surfaces a non-zero exit (with `set -e`) instead of being
# silently swallowed. Use for steps whose failure a caller must be able to
# detect, e.g. the install-helper allowlist re-bake (#279): if the helper
# can't be restarted, the deploy must fail loudly here rather than later at the
# install step with a misleading "command not allowed".
_run_strict() {
  if [[ "$VALIDATE_ONLY" == "true" ]]; then
    if [[ "$VERBOSE" == "true" ]]; then
      echo "  [validate] $*"
    fi
    return 0
  elif [[ "$DRY_RUN" == "true" ]]; then
    echo "  [would run] $*"
    return 0
  else
    "$@"
  fi
}

# Verify one manifest artifact against the tree, before anything is installed.
#
# The expected sha256 is the hash of the bytes `fraisier scaffold` wrote. A
# mismatch means the tree and this script came from different renders — an old
# install.sh against a fresh scaffold dir, or the reverse — and the drift the
# manifest exists to remove would simply move up one level: the installer would
# faithfully install a file nobody described. #323's triage found v1.141.0-era
# rendered units sitting in an app repo shadowing current ones, which is
# exactly this shape. So it is a refusal, not a warning.
#
# A missing source is likewise fatal rather than skipped. The `[ -f ]` guard
# this replaces is what turned #325 into a silent no-op: the manifest says this
# artifact was rendered, so its absence means the tree is not the tree this
# script was generated for.
#
# Runs in every mode, --dry-run included: a dry run that reported a clean plan
# for a tree the real run would refuse would be worse than no dry run at all.
_verify_artifact() {
  local rel="$1"
  local want="$2"
  local src="${SCAFFOLD_DIR}/${rel}"

  if [[ ! -f "$src" ]]; then
    echo "Error: '${rel}' is in this installer's manifest but missing from ${SCAFFOLD_DIR}." >&2
    echo "  The scaffold tree does not match the render this install.sh came from." >&2
    echo "  Re-run 'fraisier scaffold' against the full fraises.yaml." >&2
    exit 1
  fi

  if [[ -n "$want" ]] && command -v sha256sum >/dev/null 2>&1; then
    local got
    got="$(sha256sum "$src" | cut -d' ' -f1)"
    if [[ "$got" != "$want" ]]; then
      echo "Error: '${rel}' does not match the manifest this install.sh was generated from." >&2
      echo "  expected sha256 ${want}" >&2
      echo "  found    sha256 ${got}" >&2
      echo "  The scaffold tree and this installer came from different renders." >&2
      echo "  Re-run 'fraisier scaffold' so both are regenerated together." >&2
      exit 1
    fi
  fi

  _MANIFEST_CHECKED=$((_MANIFEST_CHECKED + 1))
}

# Copy one `plain` artifact. Verification already happened in the preflight
# pass, so this is only the copy.
_install_artifact() {
  _run sudo cp "${SCAFFOLD_DIR}/$1" "$2"
}

# Helper function to check if file/directory exists
_check_exists() {
  local path="$1"
  local desc="$2"
  if [[ ! -e "$path" ]]; then
    echo "  ✗ Missing: $desc ($path)" >&2
    return 1
  fi
  if [[ "$VERBOSE" == "true" ]]; then
    echo "  ✓ Found: $desc"
  fi
  return 0
}

# Helper function to ensure directory exists with correct ownership and permissions
_ensure_dir() {
  local path="$1"
  local owner="$2"
  local group="$3"
  local mode="$4"

  if [ ! -d "$path" ]; then
    echo "  Creating $path"
    _run sudo mkdir -p "$path"
  fi
  _run sudo chown "$owner:$group" "$path"
  _run sudo chmod "$mode" "$path"
}

# Helper function to check prerequisites
_validate_prerequisites() {
  local has_errors=false

  echo "Checking prerequisites..."

  # Check if running as root or can use sudo
  if [[ $EUID -ne 0 ]]; then
    if ! sudo -n true 2>/dev/null; then
      echo "  ✗ Not running as root and sudo requires password" >&2
      has_errors=true
    else
      echo "  ✓ sudo access available"
    fi
  else
    echo "  ✓ Running as root"
  fi

  # Check if install.sh was generated in the correct location (skip in standalone mode)
  if [[ "$STANDALONE" != "true" ]]; then
    if ! _check_exists "${SCAFFOLD_DIR}/install.sh" "Generated install.sh"; then
      has_errors=true
    fi
  fi

  # Check if required commands exist
  for cmd in useradd curl apt-get systemctl visudo; do
    if ! command -v "$cmd" &>/dev/null; then
      echo "  ✗ Required command not found: $cmd" >&2
      has_errors=true
    elif [[ "$VERBOSE" == "true" ]]; then
      echo "  ✓ Found: $cmd"
    fi
  done

  if [[ "$has_errors" == "true" ]]; then
    echo "Validation failed. Cannot proceed." >&2
    return 1
  fi

  echo "✓ All prerequisites met"
  return 0
}

echo "==> Setting up {{ project_name }} server"
if [[ "$DRY_RUN" == "true" ]]; then
  echo "    (DRY RUN MODE - no changes will be made)"
elif [[ "$VALIDATE_ONLY" == "true" ]]; then
  echo "    (VALIDATE ONLY MODE - checking prerequisites)"
  _validate_prerequisites
  exit $?
fi

# Create deploy user if it does not exist
if ! id -u "${DEPLOY_USER}" &>/dev/null; then
    echo "  Creating user ${DEPLOY_USER}"
    _run sudo useradd --system --create-home --shell /usr/sbin/nologin "${DEPLOY_USER}"
else
    echo "  User ${DEPLOY_USER} already exists"
fi

# Create app users (separate from deploy user for least privilege)
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set app_user = env_config.get('service', {}).get('user') %}
{% if app_user and app_user != scaffold.deploy_user %}
if _env_active "{{ env_name }}"; then
    if ! id -u "{{ app_user }}" &>/dev/null; then
        echo "  Creating app user {{ app_user }}"
        _run sudo useradd --system --create-home --shell /usr/sbin/nologin "{{ app_user }}"
    else
        echo "  App user {{ app_user }} already exists"
    fi
fi
{% endif %}
{% endfor %}
{% endfor %}

# Clean up stray __pycache__ dirs that block uv sync / uv tool install (#196, #286)
# A process running as another user can leave byte-compiled files inside a
# directory a different user owns, and that owner cannot unlink them — breaking
# the next `uv sync --frozen` or `uv tool install --force`.
#
# Every sweep matches "not owned by the identity that owns this tree" rather
# than `-user root` (#303). Root is not the only writer: `service.user` — an
# identity independent of both deploy_user and install.user — writes into the
# app venv, which is the #292 failure class and what `-user root` missed.
#
# These run under sudo deliberately: the whole point is removing files owned by
# *another* user, which an unprivileged find cannot do (the failure would be
# swallowed by _run's error suppression, making the sweep a silent no-op).
# Bounded to `-name "__pycache__" -type d` — never a bare rm -rf on a computed path.
echo "  Cleaning stray __pycache__ directories"
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set app_path = env_config.get('app_path') %}
{% set install_cfg = env_config.get('install') or fraise.get('install') or {} %}
{% set venv_owner = install_cfg.get('user') %}
{% if app_path %}
if _env_active "{{ env_name }}"; then
    _run sudo find "{{ app_path }}/.venv" -name "__pycache__" ! -user "{{ venv_owner if venv_owner else '${DEPLOY_USER}' }}" -type d -exec rm -rf {} + || true
fi
{% endif %}
{% endfor %}
{% endfor %}
_run sudo find "/home/${DEPLOY_USER}/.local/lib" -name "__pycache__" ! -user "${DEPLOY_USER}" -type d -exec rm -rf {} + || true
# uv installs tools under XDG_DATA_HOME, not ~/.local/lib — the sweep above never
# reached the tool venv. Match any foreign owner here, not just root: the residue
# reported in #286 is install_user-owned (the helper runs as install_user but
# executes the deploy user's uv-tool venv).
_run sudo find "/home/${DEPLOY_USER}/.local/share/uv/tools" -name "__pycache__" ! -user "${DEPLOY_USER}" -type d -exec rm -rf {} + || true

# Create project directory
if [ ! -d "${PROJECT_DIR}" ]; then
    echo "  Creating ${PROJECT_DIR}"
    _run sudo mkdir -p "${PROJECT_DIR}"
    _run sudo chown "${DEPLOY_USER}:${DEPLOY_USER}" "${PROJECT_DIR}"
else
    echo "  ${PROJECT_DIR} already exists"
fi

# Create managed directories in depth order (parents before children)
# All paths are derived from PathManifest for consistency across provisioning
{% for mp in manifest.sorted_by_depth() %}
{% if mp.create_if_missing %}
_ensure_dir "{{ mp.path }}" "{{ mp.owner }}" "{{ mp.group }}" "{{ '%o' | format(mp.mode) }}"
{% endif %}
{% endfor %}

# Install uv (Astral Python toolchain)
if ! command -v uv &>/dev/null; then
    echo "  Installing uv"
    if [[ "$VALIDATE_ONLY" != "true" && "$DRY_RUN" != "true" ]]; then
        curl -LsSf https://astral.sh/uv/install.sh | sh
    elif [[ "$DRY_RUN" == "true" ]]; then
        echo "    [would run] curl -LsSf https://astral.sh/uv/install.sh | sh"
    fi
else
    echo "  uv already installed: $(uv --version)"
fi

# Install system dependencies
echo "  Installing system packages"
_run sudo apt-get update -qq
_run sudo apt-get install -y -qq --no-install-recommends \
    git \
    postgresql-client \
    nginx \
    certbot \
    python3-certbot-nginx

# ---------------------------------------------------------------------------
# Manifest preflight — verify the whole tree BEFORE installing any of it.
#
# Deliberately a separate pass rather than a check inside each copy. Verifying
# as we go would install the artifacts that happen to come first and refuse
# somewhere in the middle, leaving the host half-converted between two renders
# — the worst state to debug, on the one tool you would use to recover.
# Everything is checked while nothing has been touched.
echo "==> Verifying scaffold tree against this installer's manifest"
_MANIFEST_CHECKED=0
{% for artifact in artifact_manifest.with_disposition('plain') %}
{% if artifact.environment %}
if _env_active "{{ artifact.environment }}"; then
    _verify_artifact "{{ artifact.source }}" "{{ artifact.sha256 or '' }}"
fi
{% else %}
_verify_artifact "{{ artifact.source }}" "{{ artifact.sha256 or '' }}"
{% endif %}
{% endfor %}
echo "  ${_MANIFEST_CHECKED} artifact(s) match the manifest"

# Install webhook service unit for THIS machine (#325).
#
# The source filename carries the host, the destination never does — so there
# is no unit rename, no [Install] change and no enable/disable dance.
#
# No `[ -f ]` guard, on purpose. That guard is what turned a missing source
# into a silent skip: the deploy path regenerates the tree without --server,
# which emits only slugged units, so the host-agnostic name this block used to
# ask for was never written and whatever stale file survived got installed
# instead. A missing source now means the render did not produce this
# machine's unit, and there is nothing safe to install in its place.
{% set webhook_service = 'fraisier-' ~ project_name ~ '-webhook.service' %}
WEBHOOK_SRC="${SCAFFOLD_DIR}/${_FRAISIER_WEBHOOK_UNIT}"
WEBHOOK_DST="/etc/systemd/system/{{ webhook_service }}"
if [ ! -f "${WEBHOOK_SRC}" ]; then
    echo "Error: webhook unit '${_FRAISIER_WEBHOOK_UNIT}' is missing from ${SCAFFOLD_DIR}." >&2
    echo "  This machine has no unit to install, and installing another host's" >&2
    echo "  would grant it the wrong ReadWritePaths=." >&2
    echo "  Re-run 'fraisier scaffold' against the full fraises.yaml." >&2
    exit 1
fi
echo "  Installing webhook service"
_run sudo cp "${WEBHOOK_SRC}" "${WEBHOOK_DST}"
_run sudo systemctl daemon-reload
_run sudo systemctl restart {{ webhook_service }} || true
# Restart deploy sockets so their socket files are recreated under /run/fraisier/.
# The webhook service owns RuntimeDirectory=fraisier; even with
# RuntimeDirectoryPreserve=restart, a first-time install wipes the dir.
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set socket_unit = deploy_socket_name(env_config, env_name, fraise.name) %}
if _env_active "{{ env_name }}"; then
    _run sudo systemctl restart {{ socket_unit }} || true
fi
{% endfor %}
{% endfor %}

# Install systemctl helper service and socket (replaces old systemctl wrapper)
HELPER_SERVICE_SRC="${SCAFFOLD_DIR}/systemd/fraisier-{{ project_name }}-systemctl-helper.service"
HELPER_SOCKET_SRC="${SCAFFOLD_DIR}/systemd/fraisier-{{ project_name }}-systemctl-helper.socket"
if [ -f "${HELPER_SERVICE_SRC}" ] && [ -f "${HELPER_SOCKET_SRC}" ]; then
    echo "  Installing systemctl helper service and socket"
    _run sudo cp "${HELPER_SERVICE_SRC}" \
       /etc/systemd/system/fraisier-{{ project_name }}-systemctl-helper.service
    _run sudo cp "${HELPER_SOCKET_SRC}" \
       /etc/systemd/system/fraisier-{{ project_name }}-systemctl-helper.socket
    # daemon-reload FIRST: after this, the new unit is in memory (no RuntimeDirectory=fraisier).
    # Restarting the service AFTER daemon-reload means the stop phase uses the new (safe) unit,
    # so /run/fraisier/ is NOT wiped. Stopping BEFORE daemon-reload would use the old unit and
    # wipe /run/fraisier/ because older versions had RuntimeDirectory=fraisier.
    _run sudo systemctl daemon-reload
    _run sudo systemctl restart fraisier-{{ project_name }}-systemctl-helper.service 2>/dev/null || true
    # Restart deploy sockets to ensure socket files exist after any transition turbulence
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set socket_unit = deploy_socket_name(env_config, env_name, fraise.name) %}
    if _env_active "{{ env_name }}"; then
        _run sudo systemctl restart {{ socket_unit }} || true
    fi
{% endfor %}
{% endfor %}
    # Restart helper socket to ensure socket file exists
    _run sudo systemctl restart fraisier-{{ project_name }}-systemctl-helper.socket || true
fi

# Install scaffold-install-helper service and socket (runs as root, no sudo needed)
SCAFFOLD_INSTALL_HELPER_SVC="${SCAFFOLD_DIR}/systemd/fraisier-{{ project_name }}-scaffold-install-helper.service"
SCAFFOLD_INSTALL_HELPER_SOCK="${SCAFFOLD_DIR}/systemd/fraisier-{{ project_name }}-scaffold-install-helper.socket"
if [ -f "${SCAFFOLD_INSTALL_HELPER_SVC}" ] && [ -f "${SCAFFOLD_INSTALL_HELPER_SOCK}" ]; then
    echo "  Installing scaffold-install helper"
    _run sudo cp "${SCAFFOLD_INSTALL_HELPER_SVC}" \
       /etc/systemd/system/fraisier-{{ project_name }}-scaffold-install-helper.service
    _run sudo cp "${SCAFFOLD_INSTALL_HELPER_SOCK}" \
       /etc/systemd/system/fraisier-{{ project_name }}-scaffold-install-helper.socket
    _run sudo systemctl daemon-reload
    _run sudo systemctl enable fraisier-{{ project_name }}-scaffold-install-helper.socket
    # Do NOT restart our own socket when install.sh is being executed BY the
    # scaffold-install-helper: restarting fraisier-*-scaffold-install-helper.socket
    # SIGTERMs this very helper mid-request, so the webhook's socket call reads an
    # empty reply and — under NoNewPrivileges, unable to fall back — the deploy
    # aborts before the DB step (the scaffold-install-helper self-restart race).
    # The freshly-copied unit above is loaded (daemon-reload) and takes effect on
    # the next non-helper scaffold-install (manual re-bake / post-upgrade restart).
    if [ -z "${FRAISIER_VIA_SCAFFOLD_INSTALL_HELPER:-}" ]; then
        _run sudo systemctl restart fraisier-{{ project_name }}-scaffold-install-helper.socket
    else
        echo "  (skipping scaffold-install-helper self-restart — invoked via the helper)"
    fi
fi

# Install sudoers fragment
SUDOERS_SRC="${SCAFFOLD_DIR}/sudoers"
SUDOERS_DST="/etc/sudoers.d/{{ project_name }}"
if [ -f "${SUDOERS_SRC}" ]; then
    echo "  Installing sudoers fragment"
    # Validate the STAGED file before installing it. Validating the installed
    # copy would leave an invalid fragment in /etc/sudoers.d/ — which sudo
    # treats as fatal, potentially locking the box out — while printing that
    # nothing was installed.
    if [[ "$VALIDATE_ONLY" != "true" && "$DRY_RUN" != "true" ]]; then
        if ! sudo visudo -c -f "${SUDOERS_SRC}"; then
            echo "  ✗ Sudoers syntax error! File was not installed." >&2
            exit 1
        fi
    elif [[ "$DRY_RUN" == "true" ]]; then
        echo "    [would validate] sudo visudo -c -f ${SUDOERS_SRC}"
    fi
    _run sudo install -m 0440 "${SUDOERS_SRC}" "${SUDOERS_DST}"
fi

# Install systemd units
#
# Driven from the artifact manifest rather than from hardcoded names. This is
# the block where custom-named units used to fall through: the loop asked for
# names it re-derived by hand, so anything the renderer wrote under a name this
# script did not predict was rendered and then installed by nobody, silently
# (#323). Every entry below came from `render()`'s own account of what it
# wrote, and an artifact with no disposition never reaches this file — it fails
# at scaffold time.
#
# Only `plain` artifacts are handled generically. The webhook unit, the two
# helpers, the install-helper re-bake, sudoers and the nginx vhosts keep their
# own hand-written sequences elsewhere in this script, because their ordering
# is load-bearing and a generic executor would discard the reasoning for it.
echo "  Installing systemd units"
{% for artifact in artifact_manifest.with_disposition('plain') %}
{% if artifact.environment %}
if _env_active "{{ artifact.environment }}"; then
    _install_artifact "{{ artifact.source }}" "{{ artifact.destination }}"
fi
{% else %}
_install_artifact "{{ artifact.source }}" "{{ artifact.destination }}"
{% endif %}
{% endfor %}

# Clean up stale WatchdogSec directives in existing service files
# (Older scaffold versions included WatchdogSec which causes issues with uvicorn)
echo "  Checking for stale WatchdogSec directives in systemd service files"
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set svc = env_config.service_base %}
if _env_active "{{ env_name }}"; then
    SERVICE_FILE="/etc/systemd/system/{{ svc }}.service"
    if [ -f "$SERVICE_FILE" ] && grep -q "^WatchdogSec=" "$SERVICE_FILE"; then
        echo "  Removing stale WatchdogSec from $SERVICE_FILE"
        _run sudo sed -i '/^WatchdogSec=/d' "$SERVICE_FILE"
        _run sudo systemctl daemon-reload
    fi
fi
{% endfor %}
{% endfor %}

# Migrate stale pre-0.7.1 generic deploy socket units
# These were named fraisier-{env}.socket; 0.7.1 introduced fraisier-{fraise}-{env}.socket.
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set socket_unit = deploy_socket_name(env_config, env_name, fraise.name) %}
{% set legacy_socket = 'fraisier-' ~ env_name ~ '.socket' %}
{% if socket_unit != legacy_socket %}
if _env_active "{{ env_name }}"; then
    if [ -f /etc/systemd/system/{{ legacy_socket }} ]; then
        echo "  Removing stale pre-0.7.1 socket unit {{ legacy_socket }}"
        _run sudo systemctl disable --now {{ legacy_socket }} || true
        _run sudo rm -f /etc/systemd/system/{{ legacy_socket }}
        _run sudo rm -f /etc/systemd/system/{{ legacy_socket[:-7] }}.service
        _run sudo rm -f /etc/systemd/system/{{ legacy_socket[:-7] }}@.service
        _run sudo systemctl daemon-reload
    fi
fi
{% endif %}
{% endfor %}
{% endfor %}

# Deploy sockets, deploy services and timers are `plain` artifacts and were
# installed by the manifest-driven block above, together with every other
# generically-copied unit.

_run sudo systemctl daemon-reload

# Enable and start the systemctl helper socket (socket-activated, runs as root)
if [ -f /etc/systemd/system/fraisier-{{ project_name }}-systemctl-helper.socket ]; then
    echo "  Enabling fraisier-{{ project_name }}-systemctl-helper.socket"
    _run sudo systemctl enable --now fraisier-{{ project_name }}-systemctl-helper.socket
fi

{% for ish in install_helper_sockets %}
# Install helper socket for {{ ish.fraise_name }}-{{ ish.env_name }} (runs as {{ ish.install_user }})
if _env_active "{{ ish.env_name }}"; then
    if [ -f "${SCAFFOLD_DIR}/systemd/{{ ish.socket_unit }}" ] && \
       [ -f "${SCAFFOLD_DIR}/systemd/{{ ish.service_unit }}" ]; then
        echo "  Installing install helper for {{ ish.fraise_name }}-{{ ish.env_name }}"
        # Copying the NEW unit files is the load-bearing step of the re-bake, so
        # it is _run_strict too (#279): if the new .service can't be written,
        # the stop/restart below would re-exec the STALE unit and the deploy
        # would hit a masked "command not allowed" behind a green re-bake.
        _run_strict sudo cp "${SCAFFOLD_DIR}/systemd/{{ ish.socket_unit }}" \
           /etc/systemd/system/{{ ish.socket_unit }}
        _run_strict sudo cp "${SCAFFOLD_DIR}/systemd/{{ ish.service_unit }}" \
           /etc/systemd/system/{{ ish.service_unit }}
        # Re-bake the allowlist (#279). The running .service still carries the
        # OLD allowed_command in its argv, and `enable --now` is a no-op on an
        # already-running unit — so the stale allowlist would persist. Instead:
        # daemon-reload the new unit, STOP the stale-argv .service, then enable
        # + restart the .socket so the next install connection re-execs the
        # .service with the new argv. _run_strict (not _run): a failed re-bake
        # must surface as a non-zero exit so the deploy aborts loudly (#279)
        # rather than proceeding to a masked "command not allowed".
        _run_strict sudo systemctl daemon-reload
        _run_strict sudo systemctl stop {{ ish.service_unit }}
        _run_strict sudo systemctl enable {{ ish.socket_unit }}
        _run_strict sudo systemctl restart {{ ish.socket_unit }}
    fi
fi
{% endfor %}

# Install nginx config
if [ -f "${SCAFFOLD_DIR}/nginx/gateway.conf" ]; then
    echo "  Installing nginx gateway config"
    _run sudo cp "${SCAFFOLD_DIR}/nginx/gateway.conf" \
       /etc/nginx/sites-available/{{ project_name }}
    _run sudo ln -sf /etc/nginx/sites-available/{{ project_name }} \
           /etc/nginx/sites-enabled/{{ project_name }}
fi

{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set nginx_stem = env_config.get('nginx', {}).get('server_name') or (fraise.get('name', '') + '_' + env_name) if env_config.get('nginx') else None %}
{% if nginx_stem %}
if _env_active "{{ env_name }}"; then
    if [ -f "${SCAFFOLD_DIR}/nginx/{{ nginx_stem }}.conf" ]; then
        echo "  Installing nginx config for {{ nginx_stem }}"
        _run sudo cp "${SCAFFOLD_DIR}/nginx/{{ nginx_stem }}.conf" \
           /etc/nginx/sites-available/{{ nginx_stem }}
        _run sudo ln -sf /etc/nginx/sites-available/{{ nginx_stem }} \
               /etc/nginx/sites-enabled/{{ nginx_stem }}
    fi
fi
{% endif %}
{% endfor %}
{% endfor %}

# Remove legacy /etc/nginx/conf.d/rate_limit.conf if gateway.conf now contains
# limit_req_zone — having both causes a duplicate-zone crash on nginx reload.
if [ -f "${SCAFFOLD_DIR}/nginx/gateway.conf" ] && \
   grep -q "limit_req_zone" "${SCAFFOLD_DIR}/nginx/gateway.conf" && \
   [ -f /etc/nginx/conf.d/rate_limit.conf ]; then
    echo "  Removing legacy /etc/nginx/conf.d/rate_limit.conf (now handled by gateway.conf)"
    _run sudo rm -f /etc/nginx/conf.d/rate_limit.conf
fi

if [[ "$VALIDATE_ONLY" != "true" && "$DRY_RUN" != "true" ]]; then
    sudo nginx -t && sudo systemctl reload nginx
elif [[ "$DRY_RUN" == "true" ]]; then
    echo "    [would run] sudo nginx -t && sudo systemctl reload nginx"
fi

{% if has_database %}
# PostgreSQL logging configuration
echo "  PostgreSQL logging configs generated in postgresql/"
echo "  Review and install the one matching this server's environment:"
echo "    sudo cp ${SCAFFOLD_DIR}/postgresql/fraisier_<env>.conf \\"
echo "       /etc/postgresql/*/conf.d/fraisier.conf"
echo "    sudo systemctl reload postgresql"
{% endif %}

echo "==> Setup complete for {{ project_name }}"
