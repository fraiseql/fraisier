{#- Which host gate an artifact routes to, from the owner it carries (#336).
    A fraise name means the artifact belongs to one fraise and must not reach a
    host running a different fraise under the same environment name; no fraise
    but an environment means it is env-owned and every local declaration of that
    environment activates it; neither means it is unconditional. One expression,
    so the manifest-driven loops cannot drift apart on which predicate an
    artifact deserves.

    The unconditional arm is not decoration. Every loop but one used to call
    this macro directly while the `plain` loop wrapped it in its own
    `{% if artifact.environment %}` — so the macro never saw an artifact
    carrying no environment, and rendered `_env_active ""` for one that did.
    That predicate matches nothing, which turned #341's `timer` classification
    into a silent skip: switching a timer family on REMOVED its copies from
    the plan. Caught by the golden matrix, and only because that bundle added
    a case where a timer is enabled. -#}
{% macro host_gate(owner_fraise, environment) -%}
{% if owner_fraise %}_scope_active "{{ owner_fraise }}" "{{ environment }}"{% elif environment %}_env_active "{{ environment }}"{% else %}true{% endif %}
{%- endmacro -%}
#!/usr/bin/env bash
# Generated by fraisier scaffold — do not edit manually
# Server setup script for {{ project_name }}
# Idempotent: safe to re-run
set -euo pipefail

# Parse options
DRY_RUN=false
VALIDATE_ONLY=false
VERBOSE=false
STANDALONE=false
SCAFFOLD_DIR=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --validate-only)
      VALIDATE_ONLY=true
      shift
      ;;
    --verbose|-v)
      VERBOSE=true
      shift
      ;;
    --standalone)
      STANDALONE=true
      shift
      ;;
    --scaffold-dir)
      SCAFFOLD_DIR="$2"
      STANDALONE=true
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  --dry-run                 Show what would be installed without executing"
      echo "  --validate-only           Check prerequisites only (no installation)"
      echo "  --verbose, -v             Enable verbose output"
      echo "  --standalone              Run without requiring PROJECT_DIR to exist"
      echo "  --scaffold-dir <path>     Path to scaffold files (implies --standalone)"
      echo "  --help, -h                Show this help message"
      exit 0
      ;;
    *)
      echo "Error: Unknown option '$1'" >&2
      echo "Use --help for usage information" >&2
      exit 1
      ;;
  esac
done

DEPLOY_USER="{{ scaffold.deploy_user }}"
PROJECT_DIR="/opt/{{ project_name }}"

# Determine the directory containing scaffold files.
# Default: the directory that contains this script (works when install.sh is
# deployed alongside the other generated files).  Override with --scaffold-dir.
if [[ -z "$SCAFFOLD_DIR" ]]; then
  SCAFFOLD_DIR="$(dirname "$(realpath "$0")")"
fi

# Helper function to run commands conditionally
_run() {
  if [[ "$VALIDATE_ONLY" == "true" ]]; then
    if [[ "$VERBOSE" == "true" ]]; then
      echo "  [validate] $*"
    fi
    return 0
  elif [[ "$DRY_RUN" == "true" ]]; then
    echo "  [would run] $*"
    return 0
  else
    if [[ "$VERBOSE" == "true" ]]; then
      "$@"
    else
      "$@" 2>/dev/null || true
    fi
  fi
}

# Like _run, but failures are FATAL — no `|| true`, no stderr suppression — so
# a broken step surfaces a non-zero exit (with `set -e`) instead of being
# silently swallowed. Use for steps whose failure a caller must be able to
# detect, e.g. the install-helper allowlist re-bake (#279): if the helper
# can't be restarted, the deploy must fail loudly here rather than later at the
# install step with a misleading "command not allowed".
_run_strict() {
  if [[ "$VALIDATE_ONLY" == "true" ]]; then
    if [[ "$VERBOSE" == "true" ]]; then
      echo "  [validate] $*"
    fi
    return 0
  elif [[ "$DRY_RUN" == "true" ]]; then
    echo "  [would run] $*"
    return 0
  else
    "$@"
  fi
}

# ---------------------------------------------------------------------------
# Nothing installed here may terminate the work that asked for it (#349).
#
# A deploy runs *in process* inside one of two units: the webhook service,
# which executes deploys as background tasks, and a deploy socket's
# `<stem>@N.service` instance running `fraisier deploy-daemon`. A changed
# fraises.yaml makes that deploy run this script — so restarting either unit
# from here kills the deploy that asked for the install. The webhook will not
# exit while a deploy is in flight, so systemd's stop timeout expires and the
# process is SIGKILLed, taking the deploy with it and leaving no failure record
# of its own; the caller sees only a timeout.
#
# The deploy socket is the same hazard one step removed: the generated deploy
# service carries `Requires=<its socket>`, and systemd propagates an explicit
# restart of a required unit to its dependents. That is the identical mechanism
# behind the scaffold-install-helper self-restart race guarded further down —
# that helper's .service also `Requires=` its socket.
#
# So every restart of a deploy-hosting unit goes through
# `_restart_deploy_host_unit`, which defers under a live deploy, names what it
# deferred and why, and records the debt for the deploy to pay once it has
# released its lock. A restart that is merely skipped would leave the webhook
# running its previous unit — old ReadWritePaths=, old Environment= — which is
# how a fraises.yaml change that adds an environment makes the *next* deploy
# fail on a read-only filesystem.
_FRAISIER_DEPLOY_LOCK_DIR="{{ deployment.lock_dir }}"
_FRAISIER_DEFERRED_LEDGER="${_FRAISIER_DEPLOY_LOCK_DIR}/.deferred-restarts"
_FRAISIER_DEPLOY_SIGNAL=""
_FRAISIER_DEFERRED_RESTARTS=()
# Counted separately because bash's array-length expansion opens with the two
# characters Jinja uses to start a comment, so writing it here would swallow the
# rest of this template until the next `#}`.
_FRAISIER_DEFERRED_COUNT=0

# Is any deployment lock held right now?
#
# Probes only lock files that already exist, and opens them read-only: creating
# one here would leave a root-owned file that the deploy user cannot reopen for
# writing, which is how `file_deployment_lock` acquires — so a probe would break
# the next deploy it was meant to protect.
#
# Returns 2, not 1, when the probe cannot run at all, so the caller can tell
# "no deploy is running" from "I could not look".
_deploy_locks_held() {
    command -v flock >/dev/null 2>&1 || return 2
    [ -d "$_FRAISIER_DEPLOY_LOCK_DIR" ] || return 1
    local f fd
    for f in "$_FRAISIER_DEPLOY_LOCK_DIR"/*.lock; do
        [ -e "$f" ] || continue
        exec {fd}<"$f" 2>/dev/null || continue
        if flock -n "$fd" 2>/dev/null; then
            flock -u "$fd" 2>/dev/null || true
            exec {fd}<&-
        else
            exec {fd}<&-
            return 0
        fi
    done
    return 1
}

# Is a deploy in flight? Three signals, OR'd, because each covers the others'
# gaps:
#
#   FRAISIER_DEPLOY_IN_FLIGHT   the caller's declaration. `_install_scaffold`
#                               sets it on BOTH install paths — helper socket
#                               and subprocess fallback — and it is the only
#                               signal that works on `lock_backend=database`
#                               hosts, where there is no *.lock file to probe.
#   the lock probe              the backstop, so this script does not rest on a
#                               claim it cannot check, and still protects a
#                               deploy run by an older fraisier that does not
#                               declare.
#   FRAISIER_VIA_SCAFFOLD_...   an older webhook talking to a newer install.sh
#                               over the helper socket sets only this one.
#
# An unevaluable probe resolves to "no deploy is running", with a warning —
# deliberately the opposite of the rule this project applies elsewhere, and for
# a stated reason: the authoritative signal for the dangerous path is the
# caller's declaration, which is never unevaluable. The probe is a backstop, and
# a backstop that cannot run must not block a manual `scaffold-install`, which
# is the documented remedy for a unit that has gone stale.
_deploy_in_flight() {
    if [ -n "${FRAISIER_DEPLOY_IN_FLIGHT:-}" ]; then
        _FRAISIER_DEPLOY_SIGNAL="the caller declared a deploy in flight"
        return 0
    fi
    if [ -n "${FRAISIER_VIA_SCAFFOLD_INSTALL_HELPER:-}" ]; then
        _FRAISIER_DEPLOY_SIGNAL="invoked via the scaffold-install helper, which only a deploy does"
        return 0
    fi
    local rc=0
    _deploy_locks_held || rc=$?
    if [ "$rc" -eq 0 ]; then
        _FRAISIER_DEPLOY_SIGNAL="a deployment lock is held under ${_FRAISIER_DEPLOY_LOCK_DIR}"
        return 0
    fi
    if [ "$rc" -eq 2 ]; then
        echo "  Warning: could not probe deployment locks under ${_FRAISIER_DEPLOY_LOCK_DIR}" >&2
        echo "    (flock(1) unavailable). Proceeding as if no deploy were running." >&2
    fi
    return 1
}

# The one place a deploy-hosting unit may be restarted.
_restart_deploy_host_unit() {
    local unit="$1"
    if _deploy_in_flight; then
        echo "  Deferring restart of ${unit} — ${_FRAISIER_DEPLOY_SIGNAL}."
        echo "    The new unit is on disk and daemon-reloaded; restarting it now"
        echo "    would terminate the deploy that asked for this install."
        _FRAISIER_DEFERRED_RESTARTS+=("${unit}")
        _FRAISIER_DEFERRED_COUNT=$((_FRAISIER_DEFERRED_COUNT + 1))
        return 0
    fi
    echo "  Restarting ${unit} (terminates anything running inside it)"
    _run sudo systemctl restart "${unit}" || true
}

# Record and report the debt, so a restart nobody performed is visible rather
# than silent. Merged with anything an earlier install left unpaid, because two
# config-changing deploys in a row must not lose the first one's entry.
_report_deferred_restarts() {
    [ "${_FRAISIER_DEFERRED_COUNT}" -gt 0 ] || return 0
    echo ""
    echo "Deferred restarts (${_FRAISIER_DEFERRED_COUNT}):"
    local u
    for u in "${_FRAISIER_DEFERRED_RESTARTS[@]}"; do
        echo "  - ${u}"
    done
    echo "  These units are installed and daemon-reloaded but are still running"
    echo "  their previous version. The deploy that requested this install"
    echo "  restarts them once it releases its deployment lock; 'fraisier doctor'"
    echo "  reports any that are still pending."

    if [[ "$DRY_RUN" == "true" || "$VALIDATE_ONLY" == "true" ]]; then
        echo "  [would record] ${_FRAISIER_DEFERRED_LEDGER}"
        return 0
    fi

    local pending=()
    if [ -r "${_FRAISIER_DEFERRED_LEDGER}" ]; then
        mapfile -t pending < "${_FRAISIER_DEFERRED_LEDGER}"
    fi
    if ! printf '%s\n' "${pending[@]}" "${_FRAISIER_DEFERRED_RESTARTS[@]}" \
        | grep -v '^$' | sort -u > "${_FRAISIER_DEFERRED_LEDGER}" 2>/dev/null; then
        echo "  Warning: could not record deferred restarts at ${_FRAISIER_DEFERRED_LEDGER}." >&2
        echo "    Restart these units manually once the deploy finishes:" >&2
        printf '      %s\n' "${_FRAISIER_DEFERRED_RESTARTS[@]}" >&2
        return 0
    fi
    # The webhook clears this file after paying the debt, and it runs as the
    # deploy user while this script runs as root.
    _run sudo chown "${DEPLOY_USER}:${DEPLOY_USER}" "${_FRAISIER_DEFERRED_LEDGER}" || true
}

# Sourcing this script defines the guard above and stops here; everything below
# installs. fraisier's own tests source it to drive `_deploy_in_flight` and
# `_restart_deploy_host_unit` for real, because the defect the guard exists for
# is *which* systemctl command runs — and a test that stubs the restart proves
# nothing about that.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi
# ---------------------------------------------------------------------------

# Server detection (baked at scaffold time by fraisier)
{% if machine_env_map %}
# Multi-server mode: filter based on runtime hostname.
#
# Two maps, because a host answers two different questions. `_FRAISIER_MACHINE_SCOPES`
# carries `<fraise>:<environment>` pairs — who declared what, and where — and
# `_FRAISIER_MACHINE_ENVS` is that map with the owners dropped. Keying the gate
# on environment *names* alone is #336: two fraises putting the same name on
# different servers made each host see the name as active and install the
# other's units.
declare -A _FRAISIER_MACHINE_SCOPES
{% for machine, scopes in machine_scope_map.items() %}
_FRAISIER_MACHINE_SCOPES["{{ machine }}"]="{{ scopes | join(' ') }}"
{% endfor %}
declare -A _FRAISIER_MACHINE_ENVS
{% for machine, envs in machine_env_map.items() %}
_FRAISIER_MACHINE_ENVS["{{ machine }}"]="{{ envs | join(' ') }}"
{% endfor %}

_FRAISIER_CURRENT_HOST=$(hostname -s)
_FRAISIER_CURRENT_SCOPES="${_FRAISIER_MACHINE_SCOPES["$_FRAISIER_CURRENT_HOST"]:-}"
_FRAISIER_CURRENT_ENVS="${_FRAISIER_MACHINE_ENVS["$_FRAISIER_CURRENT_HOST"]:-}"
if [[ -z "$_FRAISIER_CURRENT_ENVS" ]]; then
    echo "Error: This machine ('$_FRAISIER_CURRENT_HOST') is not registered in fraises.yaml." >&2
    echo "  Known machines: {{ machine_env_map.keys() | list | join(', ') }}" >&2
    echo "  Add this machine under 'servers:' and re-run 'fraisier scaffold'." >&2
    exit 1
fi

# Does <fraise> run here under <environment>? The gate for everything one
# fraise owns: its app service, deploy socket, install-helper pair, nginx vhost
# and the directories those live in.
#
# A `*` owner is a declaration from the global `environments:` section, which
# has no owning fraise and binds every fraise using that name — so a config
# written that way scopes exactly as it did before #336. Both halves are quoted
# literals inside `[[ == ]]`, so the `*` is matched, never expanded.
_scope_active() {
    [[ " $_FRAISIER_CURRENT_SCOPES " == *" $1:$2 "* \
    || " $_FRAISIER_CURRENT_SCOPES " == *" *:$2 "* ]]
}

# Does any fraise on this host declare <environment>? The gate for artifacts
# that genuinely have no owning fraise: the unit-installer helper is one per
# (project, environment) by design (#240) and the postgresql logging conf is
# per environment. Routing those through _scope_active would mean inventing an
# owner for them, which is how a second host authority gets born.
_env_active() { [[ " $_FRAISIER_CURRENT_ENVS " == *" $1 "* ]]; }

# Webhook unit selection (#325). The unit is addressed by host: the scaffold
# tree carries one fraisier-{project}-webhook-{slug}.service per logical
# server, and this machine installs its own. There is deliberately no fallback
# to a host-agnostic name — a leftover from a differently-filtered render is
# exactly what shipped another host's ReadWritePaths= into production.
declare -A _FRAISIER_MACHINE_WEBHOOK
{% for machine, unit in machine_webhook_map.items() %}
_FRAISIER_MACHINE_WEBHOOK["{{ machine }}"]="{{ unit }}"
{% endfor %}
_FRAISIER_WEBHOOK_UNIT="${_FRAISIER_MACHINE_WEBHOOK["$_FRAISIER_CURRENT_HOST"]:-}"
if [[ -z "$_FRAISIER_WEBHOOK_UNIT" ]]; then
    echo "Error: no webhook unit was rendered for this machine ('$_FRAISIER_CURRENT_HOST')." >&2
    echo "  Machines with a unit: {{ machine_webhook_map.keys() | list | join(', ') }}" >&2
    echo "  Add this machine under 'servers:' and re-run 'fraisier scaffold'." >&2
    exit 1
fi
{% else %}
# servers: section is required
echo "Error: 'servers:' section is required in fraises.yaml." >&2
echo "  Add logical servers and machine hostnames, then re-run 'fraisier scaffold'." >&2
exit 1
{% endif %}

# Verify one manifest artifact against the tree, before anything is installed.
#
# The expected sha256 is the hash of the bytes `fraisier scaffold` wrote. A
# mismatch means the tree and this script came from different renders — an old
# install.sh against a fresh scaffold dir, or the reverse — and the drift the
# manifest exists to remove would simply move up one level: the installer would
# faithfully install a file nobody described. #323's triage found v1.141.0-era
# rendered units sitting in an app repo shadowing current ones, which is
# exactly this shape. So it is a refusal, not a warning.
#
# A missing source is likewise fatal rather than skipped. The `[ -f ]` guard
# this replaces is what turned #325 into a silent no-op: the manifest says this
# artifact was rendered, so its absence means the tree is not the tree this
# script was generated for.
#
# Runs in every mode, --dry-run included: a dry run that reported a clean plan
# for a tree the real run would refuse would be worse than no dry run at all.
_verify_artifact() {
  local rel="$1"
  local want="$2"
  local src="${SCAFFOLD_DIR}/${rel}"

  if [[ ! -f "$src" ]]; then
    echo "Error: '${rel}' is in this installer's manifest but missing from ${SCAFFOLD_DIR}." >&2
    echo "  The scaffold tree does not match the render this install.sh came from." >&2
    echo "  Re-run 'fraisier scaffold' against the full fraises.yaml." >&2
    exit 1
  fi

  if [[ -n "$want" ]] && command -v sha256sum >/dev/null 2>&1; then
    local got
    got="$(sha256sum "$src" | cut -d' ' -f1)"
    if [[ "$got" != "$want" ]]; then
      echo "Error: '${rel}' does not match the manifest this install.sh was generated from." >&2
      echo "  expected sha256 ${want}" >&2
      echo "  found    sha256 ${got}" >&2
      echo "  The scaffold tree and this installer came from different renders." >&2
      echo "  Re-run 'fraisier scaffold' so both are regenerated together." >&2
      exit 1
    fi
  fi

  _MANIFEST_CHECKED=$((_MANIFEST_CHECKED + 1))
}

# Copy one `plain` artifact. Verification already happened in the preflight
# pass, so this is only the copy.
_install_artifact() {
  _run sudo cp "${SCAFFOLD_DIR}/$1" "$2"
}

# Helper function to check if file/directory exists
_check_exists() {
  local path="$1"
  local desc="$2"
  if [[ ! -e "$path" ]]; then
    echo "  ✗ Missing: $desc ($path)" >&2
    return 1
  fi
  if [[ "$VERBOSE" == "true" ]]; then
    echo "  ✓ Found: $desc"
  fi
  return 0
}

# Helper function to ensure directory exists with correct ownership and permissions
_ensure_dir() {
  local path="$1"
  local owner="$2"
  local group="$3"
  local mode="$4"

  if [ ! -d "$path" ]; then
    echo "  Creating $path"
    _run sudo mkdir -p "$path"
  fi
  _run sudo chown "$owner:$group" "$path"
  _run sudo chmod "$mode" "$path"
}

# Helper function to check prerequisites
_validate_prerequisites() {
  local has_errors=false

  echo "Checking prerequisites..."

  # Check if running as root or can use sudo
  if [[ $EUID -ne 0 ]]; then
    if ! sudo -n true 2>/dev/null; then
      echo "  ✗ Not running as root and sudo requires password" >&2
      has_errors=true
    else
      echo "  ✓ sudo access available"
    fi
  else
    echo "  ✓ Running as root"
  fi

  # Check if install.sh was generated in the correct location (skip in standalone mode)
  if [[ "$STANDALONE" != "true" ]]; then
    if ! _check_exists "${SCAFFOLD_DIR}/install.sh" "Generated install.sh"; then
      has_errors=true
    fi
  fi

  # Check if required commands exist
  for cmd in useradd curl apt-get systemctl visudo; do
    if ! command -v "$cmd" &>/dev/null; then
      echo "  ✗ Required command not found: $cmd" >&2
      has_errors=true
    elif [[ "$VERBOSE" == "true" ]]; then
      echo "  ✓ Found: $cmd"
    fi
  done

  if [[ "$has_errors" == "true" ]]; then
    echo "Validation failed. Cannot proceed." >&2
    return 1
  fi

  echo "✓ All prerequisites met"
  return 0
}

echo "==> Setting up {{ project_name }} server"
if [[ "$DRY_RUN" == "true" ]]; then
  echo "    (DRY RUN MODE - no changes will be made)"
elif [[ "$VALIDATE_ONLY" == "true" ]]; then
  echo "    (VALIDATE ONLY MODE - checking prerequisites)"
  _validate_prerequisites
  exit $?
fi

# Create deploy user if it does not exist
if ! id -u "${DEPLOY_USER}" &>/dev/null; then
    echo "  Creating user ${DEPLOY_USER}"
    _run sudo useradd --system --create-home --shell /usr/sbin/nologin "${DEPLOY_USER}"
else
    echo "  User ${DEPLOY_USER} already exists"
fi

# Create app users (separate from deploy user for least privilege)
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set app_user = env_config.get('service', {}).get('user') %}
{% if app_user and app_user != scaffold.deploy_user %}
if _scope_active "{{ fraise.name }}" "{{ env_name }}"; then
    if ! id -u "{{ app_user }}" &>/dev/null; then
        echo "  Creating app user {{ app_user }}"
        _run sudo useradd --system --create-home --shell /usr/sbin/nologin "{{ app_user }}"
    else
        echo "  App user {{ app_user }} already exists"
    fi
fi
{% endif %}
{% endfor %}
{% endfor %}

# Clean up stray __pycache__ dirs that block uv sync / uv tool install (#196, #286)
# A process running as another user can leave byte-compiled files inside a
# directory a different user owns, and that owner cannot unlink them — breaking
# the next `uv sync --frozen` or `uv tool install --force`.
#
# Every sweep matches "not owned by the identity that owns this tree" rather
# than `-user root` (#303). Root is not the only writer: `service.user` — an
# identity independent of both deploy_user and install.user — writes into the
# app venv, which is the #292 failure class and what `-user root` missed.
#
# These run under sudo deliberately: the whole point is removing files owned by
# *another* user, which an unprivileged find cannot do (the failure would be
# swallowed by _run's error suppression, making the sweep a silent no-op).
# Bounded to `-name "__pycache__" -type d` — never a bare rm -rf on a computed path.
echo "  Cleaning stray __pycache__ directories"
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set app_path = env_config.get('app_path') %}
{% set install_cfg = env_config.get('install') or fraise.get('install') or {} %}
{% set venv_owner = install_cfg.get('user') %}
{% if app_path %}
if _scope_active "{{ fraise.name }}" "{{ env_name }}"; then
    _run sudo find "{{ app_path }}/.venv" -name "__pycache__" ! -user "{{ venv_owner if venv_owner else '${DEPLOY_USER}' }}" -type d -exec rm -rf {} + || true
fi
{% endif %}
{% endfor %}
{% endfor %}
_run sudo find "/home/${DEPLOY_USER}/.local/lib" -name "__pycache__" ! -user "${DEPLOY_USER}" -type d -exec rm -rf {} + || true
# uv installs tools under XDG_DATA_HOME, not ~/.local/lib — the sweep above never
# reached the tool venv. Match any foreign owner here, not just root: the residue
# reported in #286 is install_user-owned (the helper runs as install_user but
# executes the deploy user's uv-tool venv).
_run sudo find "/home/${DEPLOY_USER}/.local/share/uv/tools" -name "__pycache__" ! -user "${DEPLOY_USER}" -type d -exec rm -rf {} + || true

# Create project directory
if [ ! -d "${PROJECT_DIR}" ]; then
    echo "  Creating ${PROJECT_DIR}"
    _run sudo mkdir -p "${PROJECT_DIR}"
    _run sudo chown "${DEPLOY_USER}:${DEPLOY_USER}" "${PROJECT_DIR}"
else
    echo "  ${PROJECT_DIR} already exists"
fi

# Create managed directories in depth order (parents before children)
# All paths are derived from PathManifest for consistency across provisioning
#
# Gated on `_env_active`, exactly as the artifact installs are. This block used
# to run unconditionally over every environment in fraises.yaml, so a
# production-only host created and chowned the dev host's git_repo and
# app_path: #325's shape one layer down — the units were host-filtered, the
# directories they live in were not. A path no environment owns (the shared
# /var/lib/fraisier, /opt/fraisier, the config dir) carries no environments and
# stays unconditional.
{% for mp in manifest.sorted_by_depth() %}
{% if mp.create_if_missing %}
{% if mp.environments %}
if {% for owner_fraise, env_name in mp.environments %}{% if not loop.first %} || {% endif %}_scope_active "{{ owner_fraise }}" "{{ env_name }}"{% endfor %}; then
    _ensure_dir "{{ mp.path }}" "{{ mp.owner }}" "{{ mp.group }}" "{{ '%o' | format(mp.mode) }}"
fi
{% else %}
_ensure_dir "{{ mp.path }}" "{{ mp.owner }}" "{{ mp.group }}" "{{ '%o' | format(mp.mode) }}"
{% endif %}
{% endif %}
{% endfor %}

# Install uv (Astral Python toolchain)
if ! command -v uv &>/dev/null; then
    echo "  Installing uv"
    if [[ "$VALIDATE_ONLY" != "true" && "$DRY_RUN" != "true" ]]; then
        curl -LsSf https://astral.sh/uv/install.sh | sh
    elif [[ "$DRY_RUN" == "true" ]]; then
        echo "    [would run] curl -LsSf https://astral.sh/uv/install.sh | sh"
    fi
else
    echo "  uv already installed: $(uv --version)"
fi

# Install system dependencies
echo "  Installing system packages"
_run sudo apt-get update -qq
_run sudo apt-get install -y -qq --no-install-recommends \
    git \
    postgresql-client \
    nginx \
    certbot \
    python3-certbot-nginx

# ---------------------------------------------------------------------------
# Manifest preflight — verify the whole tree BEFORE installing any of it.
#
# Deliberately a separate pass rather than a check inside each copy. Verifying
# as we go would install the artifacts that happen to come first and refuse
# somewhere in the middle, leaving the host half-converted between two renders
# — the worst state to debug, on the one tool you would use to recover.
# Everything is checked while nothing has been touched.
#
# Covers EVERY installed artifact, not just the generically-copied ones. The
# blocks below still guard their own copies with `[ -f ]`, which on its own is
# a silent skip — the exact shape of #325. The manifest says these files were
# rendered, so a missing one means the tree is not this installer's; those
# guards are now unreachable for that case rather than load-bearing.
#
# The webhook unit is excluded here and verified in its own block: which file
# this host installs is a runtime lookup, so it is checked against the hash for
# the unit actually selected.
echo "==> Verifying scaffold tree against this installer's manifest"
_MANIFEST_CHECKED=0
declare -A _FRAISIER_WEBHOOK_SHA
{% for artifact in artifact_manifest.with_disposition('webhook') %}
_FRAISIER_WEBHOOK_SHA["{{ artifact.source }}"]="{{ artifact.sha256 or '' }}"
{% endfor %}
{% for artifact in artifact_manifest.installed() if artifact.disposition != 'webhook' %}
{% if artifact.environment %}
if {{ host_gate(artifact.fraise, artifact.environment) }}; then
    _verify_artifact "{{ artifact.source }}" "{{ artifact.sha256 or '' }}"
fi
{% else %}
_verify_artifact "{{ artifact.source }}" "{{ artifact.sha256 or '' }}"
{% endif %}
{% endfor %}
# The webhook unit, verified against the hash of the file selected for THIS
# host. Done here rather than in the loop above because the selection is a
# runtime lookup, and done before the install block so a mismatch refuses
# alongside everything else rather than after the tree is half-installed.
_verify_artifact "${_FRAISIER_WEBHOOK_UNIT}" \
    "${_FRAISIER_WEBHOOK_SHA["$_FRAISIER_WEBHOOK_UNIT"]:-}"
echo "  ${_MANIFEST_CHECKED} artifact(s) match the manifest"

# Install webhook service unit for THIS machine (#325).
#
# The source filename carries the host, the destination never does — so there
# is no unit rename, no [Install] change and no enable/disable dance.
#
# No `[ -f ]` guard, on purpose. That guard is what turned a missing source
# into a silent skip: the deploy path regenerates the tree without --server,
# which emits only slugged units, so the host-agnostic name this block used to
# ask for was never written and whatever stale file survived got installed
# instead. A missing source now means the render did not produce this
# machine's unit, and there is nothing safe to install in its place.
{% set webhook_service = 'fraisier-' ~ project_name ~ '-webhook.service' %}
WEBHOOK_SRC="${SCAFFOLD_DIR}/${_FRAISIER_WEBHOOK_UNIT}"
WEBHOOK_DST="/etc/systemd/system/{{ webhook_service }}"
if [ ! -f "${WEBHOOK_SRC}" ]; then
    echo "Error: webhook unit '${_FRAISIER_WEBHOOK_UNIT}' is missing from ${SCAFFOLD_DIR}." >&2
    echo "  This machine has no unit to install, and installing another host's" >&2
    echo "  would grant it the wrong ReadWritePaths=." >&2
    echo "  Re-run 'fraisier scaffold' against the full fraises.yaml." >&2
    exit 1
fi
# Only reinstall and restart when the bytes differ. Most fraises.yaml changes
# touch nothing that reaches this unit — #349's two failing changesets edited
# `ship:` check definitions — so the common case becomes no restart at all
# rather than a deferred one. This also makes the rollback path self-cancelling:
# `_rollback_config` reinstalls the previous fraises.yaml, the unit returns to
# its old bytes, and the debt recorded above never needed paying.
if cmp -s "${WEBHOOK_SRC}" "${WEBHOOK_DST}" 2>/dev/null; then
    echo "  Webhook service unit unchanged — not reinstalled"
else
    echo "  Installing webhook service"
    _run sudo cp "${WEBHOOK_SRC}" "${WEBHOOK_DST}"
    _run sudo systemctl daemon-reload
    _restart_deploy_host_unit {{ webhook_service }}
fi
# Restart deploy sockets so their socket files are recreated under /run/fraisier/.
# The webhook service owns RuntimeDirectory=fraisier; even with
# RuntimeDirectoryPreserve=restart, a first-time install wipes the dir.
#
# That reason is also why routing these through the guard costs nothing: a
# first-time install is, by construction, a state in which no deploy is in
# flight, so the only case these restarts exist for is the case where the guard
# lets them through.
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set socket_unit = deploy_socket_name(env_config, env_name, fraise.name) %}
if _scope_active "{{ fraise.name }}" "{{ env_name }}"; then
    _restart_deploy_host_unit {{ socket_unit }}
fi
{% endfor %}
{% endfor %}

# Install systemctl helper service and socket (replaces old systemctl wrapper)
HELPER_SERVICE_SRC="${SCAFFOLD_DIR}/systemd/fraisier-{{ project_name }}-systemctl-helper.service"
HELPER_SOCKET_SRC="${SCAFFOLD_DIR}/systemd/fraisier-{{ project_name }}-systemctl-helper.socket"
if [ -f "${HELPER_SERVICE_SRC}" ] && [ -f "${HELPER_SOCKET_SRC}" ]; then
    echo "  Installing systemctl helper service and socket"
    _run sudo cp "${HELPER_SERVICE_SRC}" \
       /etc/systemd/system/fraisier-{{ project_name }}-systemctl-helper.service
    _run sudo cp "${HELPER_SOCKET_SRC}" \
       /etc/systemd/system/fraisier-{{ project_name }}-systemctl-helper.socket
    # daemon-reload FIRST: after this, the new unit is in memory (no RuntimeDirectory=fraisier).
    # Restarting the service AFTER daemon-reload means the stop phase uses the new (safe) unit,
    # so /run/fraisier/ is NOT wiped. Stopping BEFORE daemon-reload would use the old unit and
    # wipe /run/fraisier/ because older versions had RuntimeDirectory=fraisier.
    _run sudo systemctl daemon-reload
    _run sudo systemctl restart fraisier-{{ project_name }}-systemctl-helper.service 2>/dev/null || true
    # Restart deploy sockets to ensure socket files exist after any transition
    # turbulence — through the guard, for the reason given at the first copy of
    # this loop above.
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set socket_unit = deploy_socket_name(env_config, env_name, fraise.name) %}
    if _scope_active "{{ fraise.name }}" "{{ env_name }}"; then
        _restart_deploy_host_unit {{ socket_unit }}
    fi
{% endfor %}
{% endfor %}
    # Restart helper socket to ensure socket file exists
    _run sudo systemctl restart fraisier-{{ project_name }}-systemctl-helper.socket || true
fi

# Install scaffold-install-helper service and socket (runs as root, no sudo needed)
SCAFFOLD_INSTALL_HELPER_SVC="${SCAFFOLD_DIR}/systemd/fraisier-{{ project_name }}-scaffold-install-helper.service"
SCAFFOLD_INSTALL_HELPER_SOCK="${SCAFFOLD_DIR}/systemd/fraisier-{{ project_name }}-scaffold-install-helper.socket"
if [ -f "${SCAFFOLD_INSTALL_HELPER_SVC}" ] && [ -f "${SCAFFOLD_INSTALL_HELPER_SOCK}" ]; then
    echo "  Installing scaffold-install helper"
    _run sudo cp "${SCAFFOLD_INSTALL_HELPER_SVC}" \
       /etc/systemd/system/fraisier-{{ project_name }}-scaffold-install-helper.service
    _run sudo cp "${SCAFFOLD_INSTALL_HELPER_SOCK}" \
       /etc/systemd/system/fraisier-{{ project_name }}-scaffold-install-helper.socket
    _run sudo systemctl daemon-reload
    _run sudo systemctl enable fraisier-{{ project_name }}-scaffold-install-helper.socket
    # Do NOT restart our own socket when install.sh is being executed BY the
    # scaffold-install-helper: restarting fraisier-*-scaffold-install-helper.socket
    # SIGTERMs this very helper mid-request, so the webhook's socket call reads an
    # empty reply and — under NoNewPrivileges, unable to fall back — the deploy
    # aborts before the DB step (the scaffold-install-helper self-restart race).
    # The freshly-copied unit above is loaded (daemon-reload) and takes effect on
    # the next non-helper scaffold-install (manual re-bake / post-upgrade restart).
    if [ -z "${FRAISIER_VIA_SCAFFOLD_INSTALL_HELPER:-}" ]; then
        _run sudo systemctl restart fraisier-{{ project_name }}-scaffold-install-helper.socket
    else
        echo "  (skipping scaffold-install-helper self-restart — invoked via the helper)"
    fi
fi

# Install sudoers fragment
SUDOERS_SRC="${SCAFFOLD_DIR}/sudoers"
SUDOERS_DST="/etc/sudoers.d/{{ project_name }}"
if [ -f "${SUDOERS_SRC}" ]; then
    echo "  Installing sudoers fragment"
    # Validate the STAGED file before installing it. Validating the installed
    # copy would leave an invalid fragment in /etc/sudoers.d/ — which sudo
    # treats as fatal, potentially locking the box out — while printing that
    # nothing was installed.
    if [[ "$VALIDATE_ONLY" != "true" && "$DRY_RUN" != "true" ]]; then
        if ! sudo visudo -c -f "${SUDOERS_SRC}"; then
            echo "  ✗ Sudoers syntax error! File was not installed." >&2
            exit 1
        fi
    elif [[ "$DRY_RUN" == "true" ]]; then
        echo "    [would validate] sudo visudo -c -f ${SUDOERS_SRC}"
    fi
    _run sudo install -m 0440 "${SUDOERS_SRC}" "${SUDOERS_DST}"
fi

# Install systemd units
#
# Driven from the artifact manifest rather than from hardcoded names. This is
# the block where custom-named units used to fall through: the loop asked for
# names it re-derived by hand, so anything the renderer wrote under a name this
# script did not predict was rendered and then installed by nobody, silently
# (#323). Every entry below came from `render()`'s own account of what it
# wrote, and an artifact with no disposition never reaches this file — it fails
# at scaffold time.
#
# Only `plain` artifacts are handled generically. The webhook unit, the two
# helpers, the install-helper re-bake, sudoers and the nginx vhosts keep their
# own hand-written sequences elsewhere in this script, because their ordering
# is load-bearing and a generic executor would discard the reasoning for it.
echo "  Installing systemd units"
{% for artifact in artifact_manifest.with_disposition('plain') %}
if {{ host_gate(artifact.fraise, artifact.environment) }}; then
    _install_artifact "{{ artifact.source }}" "{{ artifact.destination }}"
fi
{% endfor %}

# Timers that fire (#339, #341) — `plain` plus an enable.
#
# A timer classified `plain` is copied and left inert. That was the state of
# every timer this script installs until #341: backup.timer and
# deploy-checker.timer sat on every host that had ever run scaffold-install and
# had never started, which is why three broken units went years unobserved —
# the artifact exists, the work does not happen. So `timer` is a separate
# disposition rather than a flag on `plain`.
#
# Which families land here is the operator's call, via
# `scaffold.systemd.timers`, and every family defaults to off. #339's retention
# pair is the exception: it is always `timer`, because a retention unit that
# does not fire reproduces the very incident it was built to prevent.
#
# Order is load-bearing: copy both units, daemon-reload so systemd has read
# them, THEN enable the timer. Enabling a timer whose .service is not yet on
# disk — or which systemd has not re-read — is how backup.timer and
# backup.service drifted apart, with the ordering inverted.
{% set enabled_timers = artifact_manifest.with_disposition('timer') %}
{% if enabled_timers %}
echo "  Installing timers"
# The reload is conditional on something having been copied. The tree is
# rendered for every environment in the config, so this block exists on hosts
# that install none of it; an unconditional reload there is a command in the
# plan that corresponds to no work — which is the noise a golden pin exists to
# keep out.
_TIMERS_INSTALLED=false
{% for artifact in enabled_timers %}
if {{ host_gate(artifact.fraise, artifact.environment) }}; then
    _install_artifact "{{ artifact.source }}" "{{ artifact.destination }}"
    _TIMERS_INSTALLED=true
fi
{% endfor %}
if [ "$_TIMERS_INSTALLED" = true ]; then
    _run sudo systemctl daemon-reload
fi
{% for artifact in enabled_timers if artifact.source.endswith('.timer') %}
{% set timer_unit = artifact.source | replace('systemd/', '') %}
if {{ host_gate(artifact.fraise, artifact.environment) }}; then
    echo "  Enabling {{ timer_unit }}"
    _run sudo systemctl enable --now {{ timer_unit }}
fi
{% endfor %}
{% endif %}

# Clean up stale WatchdogSec directives in existing service files
# (Older scaffold versions included WatchdogSec which causes issues with uvicorn)
echo "  Checking for stale WatchdogSec directives in systemd service files"
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set svc = env_config.service_base %}
if _scope_active "{{ fraise.name }}" "{{ env_name }}"; then
    SERVICE_FILE="/etc/systemd/system/{{ svc }}.service"
    if [ -f "$SERVICE_FILE" ] && grep -q "^WatchdogSec=" "$SERVICE_FILE"; then
        echo "  Removing stale WatchdogSec from $SERVICE_FILE"
        _run sudo sed -i '/^WatchdogSec=/d' "$SERVICE_FILE"
        _run sudo systemctl daemon-reload
    fi
fi
{% endfor %}
{% endfor %}

# Migrate stale pre-0.7.1 generic deploy socket units
# These were named fraisier-{env}.socket; 0.7.1 introduced fraisier-{fraise}-{env}.socket.
{% for fraise in local_fraises %}
{% for env_name, env_config in fraise.get('environments', {}).items() %}
{% set socket_unit = deploy_socket_name(env_config, env_name, fraise.name) %}
{% set legacy_socket = 'fraisier-' ~ env_name ~ '.socket' %}
{% if socket_unit != legacy_socket %}
if _scope_active "{{ fraise.name }}" "{{ env_name }}"; then
    if [ -f /etc/systemd/system/{{ legacy_socket }} ]; then
        echo "  Removing stale pre-0.7.1 socket unit {{ legacy_socket }}"
        _run sudo systemctl disable --now {{ legacy_socket }} || true
        _run sudo rm -f /etc/systemd/system/{{ legacy_socket }}
        _run sudo rm -f /etc/systemd/system/{{ legacy_socket[:-7] }}.service
        _run sudo rm -f /etc/systemd/system/{{ legacy_socket[:-7] }}@.service
        _run sudo systemctl daemon-reload
    fi
fi
{% endif %}
{% endfor %}
{% endfor %}

# Deploy sockets, deploy services and timers are `plain` artifacts and were
# installed by the manifest-driven block above, together with every other
# generically-copied unit.

_run sudo systemctl daemon-reload

# Enable and start the systemctl helper socket (socket-activated, runs as root)
if [ -f /etc/systemd/system/fraisier-{{ project_name }}-systemctl-helper.socket ]; then
    echo "  Enabling fraisier-{{ project_name }}-systemctl-helper.socket"
    _run sudo systemctl enable --now fraisier-{{ project_name }}-systemctl-helper.socket
fi

{% for ish in install_helper_sockets %}
# Install helper socket for {{ ish.fraise_name }}-{{ ish.env_name }} (runs as {{ ish.install_user }})
if _scope_active "{{ ish.fraise_name }}" "{{ ish.env_name }}"; then
    if [ -f "${SCAFFOLD_DIR}/systemd/{{ ish.socket_unit }}" ] && \
       [ -f "${SCAFFOLD_DIR}/systemd/{{ ish.service_unit }}" ]; then
        echo "  Installing install helper for {{ ish.fraise_name }}-{{ ish.env_name }}"
        # Copying the NEW unit files is the load-bearing step of the re-bake, so
        # it is _run_strict too (#279): if the new .service can't be written,
        # the stop/restart below would re-exec the STALE unit and the deploy
        # would hit a masked "command not allowed" behind a green re-bake.
        _run_strict sudo cp "${SCAFFOLD_DIR}/systemd/{{ ish.socket_unit }}" \
           /etc/systemd/system/{{ ish.socket_unit }}
        _run_strict sudo cp "${SCAFFOLD_DIR}/systemd/{{ ish.service_unit }}" \
           /etc/systemd/system/{{ ish.service_unit }}
        # Re-bake the allowlist (#279). The running .service still carries the
        # OLD allowed_command in its argv, and `enable --now` is a no-op on an
        # already-running unit — so the stale allowlist would persist. Instead:
        # daemon-reload the new unit, STOP the stale-argv .service, then enable
        # + restart the .socket so the next install connection re-execs the
        # .service with the new argv. _run_strict (not _run): a failed re-bake
        # must surface as a non-zero exit so the deploy aborts loudly (#279)
        # rather than proceeding to a masked "command not allowed".
        _run_strict sudo systemctl daemon-reload
        _run_strict sudo systemctl stop {{ ish.service_unit }}
        _run_strict sudo systemctl enable {{ ish.socket_unit }}
        _run_strict sudo systemctl restart {{ ish.socket_unit }}
    fi
fi
{% endfor %}

{% for pair in artifact_manifest.unit_installer_pairs() %}
# Unit-installer helper for {{ pair.environment }} (#240, runs as root)
#
# `fraisier scheduled-install` requires this socket and, when it is missing,
# tells the operator to run `fraisier scaffold-install --yes` to bootstrap it —
# which never installed it. Both sides pointed at each other and neither acted.
#
# The sequence is #279's re-bake, for #279's reason: the .service bakes its
# `--allow` allowlist into ExecStart as argv, so a running instance keeps the
# OLD allowlist and `enable --now` is a no-op on it. daemon-reload the new
# unit, STOP the stale-argv .service, then enable + restart the .socket so the
# next connection re-execs with the new argv.
#
# _run_strict throughout, also #279's reason: a half-applied re-bake leaves the
# helper accepting connections with a stale allowlist, which surfaces as a
# "not allowed" deep inside a later deploy rather than here.
if _env_active "{{ pair.environment }}"; then
    echo "  Installing unit-installer helper for {{ pair.environment }}"
    _run_strict sudo cp "${SCAFFOLD_DIR}/{{ pair.socket.source }}" \
       {{ pair.socket.destination }}
    _run_strict sudo cp "${SCAFFOLD_DIR}/{{ pair.service.source }}" \
       {{ pair.service.destination }}
    _run_strict sudo systemctl daemon-reload
    # The .service may not be running yet on a first install; stopping an
    # inactive unit is a no-op, so this stays strict rather than `|| true`.
    _run_strict sudo systemctl stop {{ pair.service_unit }}
    _run_strict sudo systemctl enable {{ pair.socket_unit }}
    _run_strict sudo systemctl restart {{ pair.socket_unit }}
fi
{% endfor %}

# Install nginx configs — sources and destinations from the manifest.
#
# The vhost filename used to be re-derived here, and the formula had drifted:
# this block asked for `{fraise}_{env}.conf` while the renderer writes
# `{project}_{fraise}_{env}.conf`. Any vhost without an explicit `server_name`
# was therefore rendered and then, behind the old `[ -f ]` guard, silently not
# installed. Both sides now read the same manifest entry.
#
# Kept as its own disposition rather than folded into `plain`: a vhost is a
# copy *plus* a sites-enabled symlink, and the gateway additionally owns the
# legacy rate_limit.conf cleanup below.
{% for vhost in artifact_manifest.with_disposition('nginx_vhost') %}
{% set link = vhost.destination.split('/')[-1] %}
{% if vhost.environment %}
if {{ host_gate(vhost.fraise, vhost.environment) }}; then
    echo "  Installing nginx config for {{ link }}"
    _run sudo cp "${SCAFFOLD_DIR}/{{ vhost.source }}" "{{ vhost.destination }}"
    _run sudo ln -sf "{{ vhost.destination }}" /etc/nginx/sites-enabled/{{ link }}
fi
{% else %}
echo "  Installing nginx gateway config"
_run sudo cp "${SCAFFOLD_DIR}/{{ vhost.source }}" "{{ vhost.destination }}"
_run sudo ln -sf "{{ vhost.destination }}" /etc/nginx/sites-enabled/{{ link }}
{% endif %}
{% endfor %}

# Remove legacy /etc/nginx/conf.d/rate_limit.conf if gateway.conf now contains
# limit_req_zone — having both causes a duplicate-zone crash on nginx reload.
if [ -f "${SCAFFOLD_DIR}/nginx/gateway.conf" ] && \
   grep -q "limit_req_zone" "${SCAFFOLD_DIR}/nginx/gateway.conf" && \
   [ -f /etc/nginx/conf.d/rate_limit.conf ]; then
    echo "  Removing legacy /etc/nginx/conf.d/rate_limit.conf (now handled by gateway.conf)"
    _run sudo rm -f /etc/nginx/conf.d/rate_limit.conf
fi

if [[ "$VALIDATE_ONLY" != "true" && "$DRY_RUN" != "true" ]]; then
    sudo nginx -t && sudo systemctl reload nginx
elif [[ "$DRY_RUN" == "true" ]]; then
    echo "    [would run] sudo nginx -t && sudo systemctl reload nginx"
fi

{% if has_database %}
# PostgreSQL logging configuration
echo "  PostgreSQL logging configs generated in postgresql/"
echo "  Review and install the one matching this server's environment:"
echo "    sudo cp ${SCAFFOLD_DIR}/postgresql/fraisier_<env>.conf \\"
echo "       /etc/postgresql/*/conf.d/fraisier.conf"
echo "    sudo systemctl reload postgresql"
{% endif %}

# ---------------------------------------------------------------------------
# Coverage report — what this installer did NOT install, and who does.
#
# #323's complaint was not that scaffold-install and scheduled-install cover
# disjoint sets of units. It is that they did so *silently*: scaffold-install
# exited 0 having never touched units the operator assumed it owned, and
# scheduled-install pointed at scaffold-install to bootstrap a socket
# scaffold-install has never installed. Neither side said anything.
#
# A wildcard install over the scaffold dir was rejected as the fix: that
# directory accumulates — v0.56.0 needed a stale-unit sweep for exactly that
# reason — so a wildcard promotes a leftover file into an installed unit,
# which is #325's failure mode generalised to every unit type.
#
# So the sets stay disjoint, and the boundary is stated out loud.
{% set app_managed = artifact_manifest.app_managed %}
{% if app_managed %}
echo ""
echo "==> Not installed here — owned by 'fraisier scheduled-install'"
echo "    These are the app's own hand-authored units, from a different source"
echo "    tree, so this installer deliberately does not touch them:"
{% for unit in app_managed %}
{% if unit.environment %}
if {{ host_gate(unit.fraise, unit.environment) }}; then
    echo "      {{ unit.unit_name }}  <- {{ unit.source_dir }}"
fi
{% else %}
echo "      {{ unit.unit_name }}  <- {{ unit.source_dir }}"
{% endif %}
{% endfor %}
echo "    Run: fraisier scheduled-install"
{% endif %}
{% set gaps = artifact_manifest.gaps() %}
{% if gaps %}
echo ""
echo "==> Rendered but installed by nothing (known gaps)"
{% for gap in gaps %}
echo "      {{ gap.source }}"
echo "        {{ gap.note }}"
{% endfor %}
echo "    These are tracked in the artifact manifest, not silently absent."
{% endif %}
{#- Timers copied and deliberately not started (#341).

    The third "here is something this installer did not do" block, and the one
    with the most history behind it: backup.timer and deploy-checker.timer have
    been copied to every host that ever ran this script and started on none,
    and nothing ever said so. Three units were broken the whole time, and the
    silence is why. An operator reading this output now learns the state, what
    the timer would do, and the single line that changes it. -#}
{% set inert = artifact_manifest.inert_timers() %}
{% if inert %}
echo ""
echo "==> Installed and not enabled"
echo "    Copied to /etc/systemd/system and deliberately not started:"
{% for timer in inert %}
echo "      {{ timer.source | replace('systemd/', '') }}"
echo "        {{ timer.note }}"
{% endfor %}
echo "    Set the flag in fraises.yaml and re-run this script to start one."
{% endif %}

{#- The fourth "here is something this installer did not do" block, and the
    only one that is owed back: a deferred restart leaves a unit installed and
    not running, which is the state the three blocks above exist to make
    visible. Reported last so it sits next to the completion line, and recorded
    so the deploy can pay it. -#}
_report_deferred_restarts

echo ""
echo "==> Setup complete for {{ project_name }}"
