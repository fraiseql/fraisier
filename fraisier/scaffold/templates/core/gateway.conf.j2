# Nginx gateway configuration for {{ project_name }}
# Generated by fraisier scaffold

{% set api_fraises = [] %}
{% for fraise in local_fraises %}
{% if fraise.type == 'api' %}
{% if api_fraises.append(fraise) %}{% endif %}
{% endif %}
{% endfor %}
{% set has_server_names = api_fraises | selectattr('server_name') | list | length > 0 %}
{% if not has_per_env_nginx %}
{% for fraise in api_fraises %}
upstream {{ project_name }}_{{ fraise.name }}_backend {
    server 127.0.0.1:{{ fraise.port }};
    keepalive 32;
}
{% endfor %}
{% endif %}

# Rate limiting (referenced by per-environment configs)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate={{ scaffold.nginx.rate_limit }};

{% if not has_per_env_nginx and scaffold.nginx.cors_origins %}
# CORS origin matching
map $http_origin $cors_origin {
    default "";
{% for origin in scaffold.nginx.cors_origins_escaped %}
    "~{{ origin }}"  $http_origin;
{% endfor %}
}
{% endif %}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

{% if not has_per_env_nginx %}
{% if has_server_names %}
{% for fraise in api_fraises %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ fraise.server_name }};

{% if scaffold.nginx.ssl_provider == 'letsencrypt' %}
    ssl_certificate /etc/letsencrypt/live/{{ fraise.server_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ fraise.server_name }}/privkey.pem;
{% endif %}

    # SSL hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

{% if scaffold.nginx.cors_origins %}
    # CORS
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, apollographql-client-name, apollographql-client-version" always;
    add_header Access-Control-Max-Age 86400 always;
{% endif %}

    location / {
{% if scaffold.nginx.cors_origins %}
        # CORS preflight: respond immediately without hitting the backend or rate limiter
        if ($request_method = OPTIONS) {
            return 204;
        }
{% endif %}
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://{{ project_name }}_{{ fraise.name }}_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

{% endfor %}
{% else %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name _;

{% if scaffold.nginx.ssl_provider == 'letsencrypt' %}
    ssl_certificate /etc/letsencrypt/live/{{ project_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ project_name }}/privkey.pem;
{% endif %}

    # SSL hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

{% if scaffold.nginx.cors_origins %}
    # CORS
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, apollographql-client-name, apollographql-client-version" always;
    add_header Access-Control-Max-Age 86400 always;
{% endif %}

    # Restricted paths
{% for path in scaffold.nginx.restricted_paths %}
    location {{ path }} {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://{{ project_name }}_{{ gateway_fraise }}_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% endfor %}

{% for fraise in api_fraises %}
{% if fraise.location %}
    location {{ fraise.location }} {
{% if scaffold.nginx.cors_origins %}
        # CORS preflight: respond immediately without hitting the backend or rate limiter
        if ($request_method = OPTIONS) {
            return 204;
        }
{% endif %}
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://{{ project_name }}_{{ fraise.name }}_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% elif api_fraises | length == 1 %}
    location / {
{% if scaffold.nginx.cors_origins %}
        # CORS preflight: respond immediately without hitting the backend or rate limiter
        if ($request_method = OPTIONS) {
            return 204;
        }
{% endif %}
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://{{ project_name }}_{{ fraise.name }}_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% else %}
    location /{{ fraise.name }}/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://{{ project_name }}_{{ fraise.name }}_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% endif %}
{% endfor %}
}
{% endif %}
{% endif %}
